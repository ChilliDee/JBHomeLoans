<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same root namespace as the CRM FE project, so components copy across without namespace edits -->
    <RootNamespace>FE</RootNamespace>
    <AssemblyName>Sandox</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The base classes for the _C / _S / _RC pattern (ST_Subscriptions, ObservableProperty, InterceptorErrorHandlingFactory)
         live in the Framework folder. BusinessLogic.Core is not referenced. Castle.Core is what the interceptor factory uses. -->
    <PackageReference Include="Castle.Core" Version="5.2.1" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="MsgReader" Version="6.0.11" />
    <PackageReference Include="Syncfusion.Blazor.SfPdfViewer" Version="33.2.3" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="33.2.3" />
    <PackageReference Include="Syncfusion.Blazor.WordProcessor" Version="33.2.3" />
    <PackageReference Include="TinyMCE.Blazor" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Pages\" />
  </ItemGroup>

</Project>
