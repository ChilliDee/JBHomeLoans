@page "/"

<PageTitle>Sandbox · Ticket queue</PageTitle>

<div id="@_d.I.ClassName" class="mx-auto max-w-6xl p-8">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <!-- Skeleton loading -->
        <div class="animate-pulse">
            <div class="h-7 w-48 rounded bg-gray-200"></div>
            <div class="mt-2 h-4 w-80 rounded bg-gray-200"></div>

            <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
                @for (int s = 0; s < 4; s++)
                {
                    <div class="h-20 rounded-lg border border-gray-200 bg-white"></div>
                }
            </div>

            <div class="mt-6 flex gap-2">
                @for (int c = 0; c < 5; c++)
                {
                    <div class="h-8 w-28 rounded-lg bg-gray-200"></div>
                }
            </div>

            <div class="mt-4 rounded-lg border border-gray-200 bg-white">
                @for (int r = 0; r < 5; r++)
                {
                    <div class="flex items-center gap-4 border-b border-gray-100 px-4 py-4">
                        <div class="h-2 w-2 rounded-full bg-gray-200"></div>
                        <div class="h-4 w-1/3 rounded bg-gray-200"></div>
                        <div class="ml-auto h-5 w-20 rounded bg-gray-200"></div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            <svg class="mt-0.5 h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        var visible = _act.VisibleTickets();
        var selected = _act.SelectedTicket();

        <!-- Header -->
        <div class="flex items-end justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Ticket queue</h1>
                <p class="mt-1 text-sm text-gray-600">Demo data only. Every ticket is one action with one due time, sorted by whose move it is.</p>
            </div>
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-200 transition-colors hover:bg-gray-50 cursor-pointer"
                    @onclick="async () => {
                        await _req.InitialRequestAsync();
                        _inputs.SetInitialInputs();
                        _state.SelectTicket(0);
                        await _d.StateUpdate();
                    }">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                Reset demo data
            </button>
        </div>

        <!-- Stat cards -->
        <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            <div class="rounded-lg border border-gray-200 bg-white p-4">
                <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Open tickets</div>
                <div class="mt-1 text-2xl font-semibold text-gray-900">@_act.CountNature("all")</div>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-4">
                <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Overdue</div>
                <div class="mt-1 text-2xl font-semibold text-red-600">@_act.CountOverdue()</div>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-4">
                <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Due today</div>
                <div class="mt-1 text-2xl font-semibold text-amber-600">@_act.CountDueToday()</div>
            </div>
            <div class="rounded-lg border border-gray-200 bg-white p-4">
                <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Client waiting on us to do</div>
                <div class="mt-1 text-2xl font-semibold text-rose-600">@_act.CountNature("us")</div>
            </div>
        </div>

        <!-- Filters + search -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        class="@_switch.FilterChip("all")"
                        @onclick="async () => { _state.ShowAllNatures(); await _d.StateUpdate(); }">
                    All
                    <span class="@_switch.FilterCount("all")">@_act.CountNature("all")</span>
                </button>
                @foreach (var nature in _d.I.Inputs.Natures)
                {
                    <button type="button"
                            class="@_switch.FilterChip(nature.Key)"
                            @onclick="async () => { _state.SetNatureFilter(nature.Key); await _d.StateUpdate(); }">
                        <span class="@_switch.NatureDot(nature.Key)"></span>
                        @nature.Name
                        <span class="@_switch.FilterCount(nature.Key)">@_act.CountNature(nature.Key)</span>
                    </button>
                }
            </div>

            <div class="w-72 pt-2">
                <FE.Components.Domains.Utlility.Inputs.TextInput
                    @bind-Value="_d.I.Inputs.Search"
                    Label="Search"
                    Id="ticket-search"
                    Name="ticket-search"
                    Placeholder="Type Client or objective" />
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 items-start gap-6 lg:grid-cols-5">
            <!-- Ticket list -->
            <div class="overflow-hidden rounded-lg border border-gray-200 bg-white lg:col-span-3">
                <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
                    <h2 class="text-sm font-semibold text-gray-900">Tickets</h2>
                    <span class="text-xs text-gray-500">@visible.Count of @_act.CountNature("all")</span>
                </div>

                @if (visible.Count == 0)
                {
                    <div class="px-4 py-12 text-center">
                        <p class="text-sm font-medium text-gray-900">No tickets match</p>
                        <p class="mt-1 text-sm text-gray-500">Try a different filter or clear the search.</p>
                    </div>
                }

                @foreach (var ticket in visible)
                {
                    <button type="button"
                            class="@_switch.RowClass(ticket.Id)"
                            @onclick="async () => { _state.SelectTicket(ticket.Id); await _d.StateUpdate(); }">
                        <span class="@_switch.NatureDot(ticket.NatureKey)"></span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium text-gray-900">@ticket.Objective</span>
                            <span class="block truncate text-xs text-gray-500">@ticket.Client · @_act.NatureName(ticket.NatureKey)</span>
                        </span>
                        @if (ticket.Attempt.HasValue)
                        {
                            <span class="hidden rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 sm:inline">@ticket.Attempt of @ticket.AttemptMax</span>
                        }
                        <span class="@_switch.DueBadge(ticket.DueAt)">@_act.DueLabel(ticket.DueAt)</span>
                    </button>
                }
            </div>

            <!-- Detail panel -->
            <div class="rounded-lg border border-gray-200 bg-white lg:sticky lg:top-6 lg:col-span-2">
                @if (selected == null)
                {
                    <div class="px-6 py-16 text-center">
                        <svg class="mx-auto h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
                        </svg>
                        <p class="mt-3 text-sm font-medium text-gray-900">Select a ticket</p>
                        <p class="mt-1 text-sm text-gray-500">Its details and actions show up here.</p>
                    </div>
                }
                else
                {
                    <div class="border-b border-gray-200 px-6 py-5">
                        <span class="@_switch.NatureChip(selected.NatureKey)">
                            <span class="@_switch.NatureDot(selected.NatureKey)"></span>
                            @_act.NatureName(selected.NatureKey)
                        </span>
                        <h2 class="mt-3 text-lg font-semibold text-gray-900">@selected.Objective</h2>
                        <p class="mt-1 text-sm text-gray-600">@_act.NatureBlurb(selected.NatureKey)</p>
                    </div>

                    <dl class="grid grid-cols-2 gap-x-4 gap-y-4 border-b border-gray-200 px-6 py-5 text-sm">
                        <div>
                            <dt class="text-xs text-gray-500">Client</dt>
                            <dd class="mt-0.5 font-medium text-gray-900">@selected.Client</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500">Assigned to</dt>
                            <dd class="mt-0.5 font-medium text-gray-900">@selected.Assignee</dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500">Due</dt>
                            <dd class="mt-0.5">
                                <span class="@_switch.DueBadge(selected.DueAt)">@_act.DueLabel(selected.DueAt)</span>
                                <span class="ml-1 text-xs text-gray-500">@selected.DueAt.ToString("ddd d MMM, h:mm tt")</span>
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs text-gray-500">Stage</dt>
                            <dd class="mt-0.5 font-medium text-gray-900">@selected.Stage</dd>
                        </div>
                        @if (selected.Attempt.HasValue)
                        {
                            <div class="col-span-2">
                                <dt class="text-xs text-gray-500">Attempt @selected.Attempt of @selected.AttemptMax</dt>
                                <dd class="mt-1.5 flex gap-1" aria-hidden="true">
                                    @for (int a = 1; a <= selected.AttemptMax; a++)
                                    {
                                        <span class="@(a <= selected.Attempt ? "h-1.5 flex-1 rounded-full bg-indigo-500" : "h-1.5 flex-1 rounded-full bg-gray-200")"></span>
                                    }
                                </dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(selected.ReplacesStatus))
                        {
                            <div class="col-span-2 rounded-md bg-gray-50 px-3 py-2">
                                <dt class="text-xs text-gray-500">Replaces status</dt>
                                <dd class="mt-0.5 text-sm text-gray-700">@selected.ReplacesStatus</dd>
                            </div>
                        }
                    </dl>

                    <div class="border-b border-gray-200 px-6 py-5">
                        <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Note</h3>
                        <p class="mt-1.5 text-sm text-gray-700">@selected.Note</p>
                    </div>

                    <div class="border-b border-gray-200 px-6 py-5">
                        <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Activity</h3>
                        <ul class="mt-3 flex flex-col gap-3">
                            @foreach (var entry in selected.Activity)
                            {
                                <li class="flex items-start gap-3 text-sm">
                                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300"></span>
                                    <span class="flex-1 text-gray-700">@entry.Text</span>
                                    <span class="shrink-0 text-xs text-gray-400">@entry.When</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="px-6 py-4">
                        @if (_act.HasUpdateFailed())
                        {
                            <p class="mb-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">The update did not go through. Try again.</p>
                        }
                        <div class="flex items-center justify-end gap-2">
                            @if (_act.IsUpdating())
                            {
                                <span class="mr-auto text-xs text-gray-500">Saving...</span>
                            }
                            @if (selected.Attempt.HasValue)
                            {
                                <button type="button"
                                        disabled="@_act.IsUpdating()"
                                        class="rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-200 transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                                        @onclick="async () => {
                                            await _req.LogAttemptAsync(selected.Id, selected.Attempt);
                                            _act.ApplyUpdateResponse();
                                            await _d.StateUpdate();
                                        }">
                                    Log attempt
                                </button>
                            }
                            <button type="button"
                                    disabled="@_act.IsUpdating()"
                                    class="rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                                    @onclick="async () => {
                                        await _req.CloseTicketAsync(selected.Id, selected.Attempt);
                                        _act.ApplyUpdateResponse();
                                        _state.SelectTicket(0);
                                        await _d.StateUpdate();
                                    }">
                                Close ticket
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
