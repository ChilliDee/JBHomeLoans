<div id="@_d.I.ClassName" class="bg-white">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="flex items-center justify-center gap-3 p-6 text-sm text-slate-500">
            <svg class="animate-spin w-4 h-4 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Loading...
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-4 my-3 flex items-start gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            <svg class="w-4 h-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <div class="mx-auto max-w-7xl px-6 pb-24 md:pb-32 lg:px-8">
            <div class="rounded-3xl bg-amber-400 px-6 py-16 text-center md:px-16 md:py-24">
                <h2 class="mx-auto max-w-3xl text-4xl font-black leading-tight tracking-tight text-slate-950 md:text-6xl">
                    Ready when you are.
                </h2>
                <p class="mx-auto mt-6 max-w-xl text-lg text-slate-900">
                    Run the numbers now and see what your next vehicle could cost each month.
                </p>

                <a href="/home#calculator"
                   class="mt-10 inline-flex items-center gap-2 rounded-full bg-slate-950 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-slate-800">
                    Get a quote
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                </a>

                <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                    @foreach (var point in _d.I.Inputs.Items)
                    {
                        <li class="flex items-center gap-2 text-sm font-medium text-slate-950">
                            <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                            @point.Description
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
