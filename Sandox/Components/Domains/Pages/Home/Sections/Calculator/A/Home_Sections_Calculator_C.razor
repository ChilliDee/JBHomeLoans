<div id="@_d.I.ClassName" class="bg-slate-950">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="flex items-center justify-center gap-3 p-6 text-sm text-slate-300">
            <svg class="animate-spin w-4 h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Loading...
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-4 my-3 flex items-start gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            <svg class="w-4 h-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 py-24 md:py-32 lg:grid-cols-2 lg:gap-20 lg:px-8">
            <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-amber-400">Repayment calculator</p>
                <h2 class="mt-4 text-4xl font-black leading-tight tracking-tight text-white md:text-6xl">
                    See your repayments before you commit.
                </h2>
                <p class="mt-6 max-w-xl text-lg text-slate-300">
                    Enter the amount, the term and an interest rate to get an estimate in seconds.
                </p>

                <div class="mt-12 border-t border-white/10 pt-10">
                    @if (_act.ShowCalculationFailed())
                    {
                        <div class="flex items-start gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                            @_d.RC_Internal.Calculate_.ResponseData.ErrorMessage
                        </div>
                    }
                    else if (_act.ShowResult())
                    {
                        <p class="text-sm font-medium uppercase tracking-widest text-slate-400">Estimated monthly repayment</p>
                        <p class="mt-3 text-6xl font-black tracking-tight text-amber-400 md:text-7xl">$@_d.RC_Internal.Calculate_.ResponseData.MonthlyRepayment.ToString("N2")</p>

                        <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6">
                            <div>
                                <dt class="text-sm text-slate-400">Fortnightly</dt>
                                <dd class="mt-1 text-2xl font-bold text-white">$@_d.RC_Internal.Calculate_.ResponseData.FortnightlyRepayment.ToString("N2")</dd>
                            </div>
                            <div>
                                <dt class="text-sm text-slate-400">Weekly</dt>
                                <dd class="mt-1 text-2xl font-bold text-white">$@_d.RC_Internal.Calculate_.ResponseData.WeeklyRepayment.ToString("N2")</dd>
                            </div>
                            <div>
                                <dt class="text-sm text-slate-400">Total interest</dt>
                                <dd class="mt-1 text-2xl font-bold text-white">$@_d.RC_Internal.Calculate_.ResponseData.TotalInterest.ToString("N2")</dd>
                            </div>
                            <div>
                                <dt class="text-sm text-slate-400">Total repayable</dt>
                                <dd class="mt-1 text-2xl font-bold text-white">$@_d.RC_Internal.Calculate_.ResponseData.TotalRepayable.ToString("N2")</dd>
                            </div>
                        </dl>
                    }
                    else
                    {
                        <p class="text-sm font-medium uppercase tracking-widest text-slate-400">Estimated monthly repayment</p>
                        <p class="mt-3 text-6xl font-black tracking-tight text-slate-700 md:text-7xl">$0.00</p>
                        <p class="mt-6 text-base text-slate-400">Fill in the three fields and press Calculate to see your estimate.</p>
                    }
                </div>
            </div>

            <div class="self-start rounded-3xl bg-white p-8 shadow-2xl md:p-10">
                <h3 class="text-2xl font-bold tracking-tight text-slate-950">Your loan</h3>

                <div class="mt-8 flex flex-col gap-7">
                    <FE.Components.Domains.Utlility.Inputs.CurrencyInput
                        @bind-Value="_d.I.Inputs.LoanAmount"
                        Label="Loan amount"
                        Id="home-calculator-loan-amount"
                        Name="home-calculator-loan-amount"
                        Required="true"
                        ValidationRef="_inputs.AddValidator"
                        ValidationUnref="_inputs.RemoveValidator" />

                    <FE.Components.Domains.Utlility.Inputs.NumberInput
                        @bind-Value="_d.I.Inputs.TermYears"
                        Label="Loan term (years)"
                        Id="home-calculator-term-years"
                        Name="home-calculator-term-years"
                        DecimalPlaces="0"
                        Min="_d.I.Inputs.TermMinYears"
                        Max="_d.I.Inputs.TermMaxYears"
                        Required="true"
                        ValidationRef="_inputs.AddValidator" />

                    <FE.Components.Domains.Utlility.Inputs.PercentageInput
                        @bind-Value="_d.I.Inputs.InterestRate"
                        Label="Interest rate (% p.a.)"
                        Id="home-calculator-interest-rate"
                        Name="home-calculator-interest-rate"
                        Required="true"
                        ValidationRef="_inputs.AddValidator" />

                    @if (_act.ShowFailedLabels())
                    {
                        <div class="text-sm text-red-700">Please check: @string.Join(", ", _d.I.Inputs.FailedLabels)</div>
                    }

                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-400 px-8 py-4 text-base font-semibold text-slate-950 transition-colors hover:bg-amber-300 cursor-pointer disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@_act.IsCalculating()"
                            @onclick="async () => {
                                _inputs.ValidateAll();
                                await _req.CalculateAsync();
                                await _d.StateUpdate();
                            }">
                        @if (_act.IsCalculating())
                        {
                            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                            <span>Calculating...</span>
                        }
                        else
                        {
                            <span>Calculate</span>
                        }
                    </button>
                </div>

                <p class="mt-6 text-xs leading-relaxed text-slate-500">
                    Estimate only. Not a quote or an offer of finance. Excludes fees and charges, and assumes the rate you enter stays the same for the whole term.
                </p>
            </div>
        </div>
    }
</div>
