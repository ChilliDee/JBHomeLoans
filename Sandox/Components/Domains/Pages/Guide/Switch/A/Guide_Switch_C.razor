<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Switch</h3>
            <p class="mt-1 text-sm text-gray-500">Returns complete CSS class strings only, never booleans or logic. The colour follows the status.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_switch</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <div class="flex flex-wrap gap-3">
                @foreach (var status in _act.Statuses())
                {
                    <span class="@_switch.Selected(status)">
                        <button type="button" class="@_switch.StatusPill(status)" @onclick="async () => { _act.SelectStatus(status); await _d.StateUpdate(); }">@status</button>
                    </span>
                }
            </div>
            <p class="mt-3 text-sm text-gray-700">Selected: <span class="@_switch.StatusPill(_act.SelectedStatus())">@_act.SelectedStatus()</span></p>
        }
    </div>
</div>
