<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">State</h3>
            <p class="mt-1 text-sm text-gray-500">The only place that writes to <span class="font-mono">_S</span> values. The razor calls a method here, and everything subscribed updates.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_state</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <div class="flex items-center gap-3">
                <button type="button" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => { _state.Decrease(); await _d.StateUpdate(); }">- 1</button>
                <span class="w-10 text-center text-2xl font-semibold text-gray-900">@_act.SharedCount()</span>
                <button type="button" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => { _state.Increase(); await _d.StateUpdate(); }">+ 1</button>
            </div>
            <p class="mt-3 text-xs text-gray-500">Last changed by: @_act.LastChangedBy()</p>
        }
    </div>
</div>
