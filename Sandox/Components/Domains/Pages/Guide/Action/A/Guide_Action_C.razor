<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Action</h3>
            <p class="mt-1 text-sm text-gray-500">General logic: calculations and yes/no helpers for the razor's <span class="font-mono">@@if</span>. Change a quantity and watch the total and the warning.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_act</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <ul class="divide-y divide-gray-100 text-sm">
                @foreach (var item in _act.Items())
                {
                    <li class="flex items-center justify-between gap-3 py-2">
                        <span class="text-gray-700">@item.Name</span>
                        <span class="flex items-center gap-2">
                            <button type="button" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => { _act.ChangeQuantity(item.Id, -1); await _d.StateUpdate(); }">-</button>
                            <span class="w-6 text-center">@item.Quantity</span>
                            <button type="button" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => { _act.ChangeQuantity(item.Id, 1); await _d.StateUpdate(); }">+</button>
                        </span>
                    </li>
                }
            </ul>
            <p class="mt-3 text-sm font-semibold text-gray-900">Total: @_act.Total().ToString("C2")</p>
            @if (_act.ShowWarning())
            {
                <p class="mt-2 rounded-md bg-amber-50 p-2 text-xs text-amber-800">Over the sample budget of $60.00.</p>
            }
            @if (_act.ShowEmpty())
            {
                <p class="mt-2 text-xs text-gray-500">Nothing selected.</p>
            }
        }
    </div>
</div>
