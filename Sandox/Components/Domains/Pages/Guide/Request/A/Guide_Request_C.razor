<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Request</h3>
            <p class="mt-1 text-sm text-gray-500">Thin wrappers. The razor calls <span class="font-mono">_req</span>, which builds a request object and hands it to an RC. Nothing else.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_req</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <button type="button" disabled="@_act.IsFetching()" class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                    @onclick="async () => await _req.FetchMessageAsync()">
                @_act.ButtonLabel()
            </button>
            @if (_act.Message() != string.Empty)
            {
                <p class="mt-3 rounded-md bg-gray-50 p-3 font-mono text-xs text-gray-700">@_act.Message()</p>
            }
        }
    </div>
</div>
