<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Fail, then retry</h3>
            <p class="mt-1 text-sm text-gray-500">The first attempt fails and shows a Retry button. The RC remembers how many times it ran, so the second attempt succeeds.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_RC · retry</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="animate-pulse space-y-2">
                <div class="h-4 w-3/4 rounded bg-gray-200"></div>
                <div class="h-4 w-1/2 rounded bg-gray-200"></div>
            </div>
            <p class="mt-3 text-xs text-gray-500">Loading...</p>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">@_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage</div>
            <button type="button" class="mt-3 rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer" @onclick="async () => await _req.InitialRequestAsync()">Retry</button>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <ul class="divide-y divide-gray-100 text-sm text-gray-700">
                @foreach (var row in _act.Rows())
                {
                    <li class="py-2">@row</li>
                }
            </ul>
            <p class="mt-3 text-xs text-green-700">Recovered on attempt @_act.Attempts().</p>
            <button type="button" class="mt-3 rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => await _req.InitialRequestAsync()">Load again</button>
        }
    </div>
</div>
