<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">StateSub</h3>
            <p class="mt-1 text-sm text-gray-500">Subscribes to an <span class="font-mono">_S</span> value when the component starts and unsubscribes when it is disposed. A change calls the callback, which re-renders.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_stateSub</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <p class="text-3xl font-semibold text-gray-900">@_act.SharedCount()</p>
            <p class="mt-1 text-sm text-gray-500">Shared count. This card only listens.</p>
            <p class="mt-3 text-sm text-gray-700">Re-rendered <span class="font-semibold">@_act.TimesFired()</span> times by its subscription.</p>
            <p class="mt-1 text-xs text-gray-400">Change the value in the State card or the counters below.</p>
        }
    </div>
</div>
