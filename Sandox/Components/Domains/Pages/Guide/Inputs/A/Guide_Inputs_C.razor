<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Inputs</h3>
            <p class="mt-1 text-sm text-gray-500">Holds the form values. Name is required and validates itself, Nickname is pre-populated and optional. <span class="font-mono">ValidateAll()</span> runs first and the request only fires when <span class="font-mono">IsValid</span>.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_inputs</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <div class="space-y-3">
                <FE.Components.Domains.Utlility.Inputs.TextInput @bind-Value="_d.I.Inputs.Name"
                                                                 Label="Name" Id="guide-inputs-name" Name="guide-inputs-name"
                                                                 Placeholder="Required"
                                                                 Required="true"
                                                                 ValidationRef="_inputs.AddValidator"
                                                                 ValidationUnref="_inputs.RemoveValidator" />
                <FE.Components.Domains.Utlility.Inputs.TextInput @bind-Value="_d.I.Inputs.Nickname"
                                                                 Label="Nickname (optional)" Id="guide-inputs-nickname" Name="guide-inputs-nickname" />
            </div>
            <div class="mt-4 flex items-center gap-3">
                <button type="button" disabled="@_act.IsSaving()" class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                        @onclick="async () => {
                            _inputs.ValidateAll();
                            await _req.SaveAsync();
                            await _d.StateUpdate();
                        }">
                    @_act.ButtonLabel()
                </button>
                @if (_act.HasSaved())
                {
                    <span class="text-sm text-green-700">Saved (mock).</span>
                }
            </div>
            @if (_act.ShowFailedLabels())
            {
                <p class="mt-3 text-sm text-red-700">Please check: @_act.FailedLabels()</p>
            }
        }
    </div>
</div>
