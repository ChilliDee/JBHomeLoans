<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Navigation</h3>
            <p class="mt-1 text-sm text-gray-500">All route changes go through <span class="font-mono">_nav</span>, which uses <span class="font-mono">NavManager</span>. Try the jumps, then reload.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_nav</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="h-16 animate-pulse rounded-md bg-gray-100"></div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <div class="flex flex-wrap gap-2">
                @foreach (var section in _act.Sections())
                {
                    <button type="button" class="rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="() => _nav.GoToSection(section.Id)">@section.Label</button>
                }
            </div>
            <p class="mt-3 break-all font-mono text-xs text-gray-500">@_act.CurrentUri()</p>
            <button type="button" class="mt-3 rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="() => _nav.ReloadPage()">Reload page</button>
        }
    </div>
</div>
