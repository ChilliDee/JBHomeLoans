<div id="@_d.I.ClassName" class="flex h-full flex-col rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900">Failure</h3>
            <p class="mt-1 text-sm text-gray-500">The unhappy path. The mock step throws, and the RC turns the exception into a failed state with a message.</p>
        </div>
        <span class="shrink-0 rounded-md bg-indigo-50 px-2 py-1 font-mono text-xs text-indigo-700">_RC · failure</span>
    </div>
    <div class="mt-4 flex-1">
        @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
        {
            <div class="animate-pulse space-y-2">
                <div class="h-4 w-3/4 rounded bg-gray-200"></div>
                <div class="h-4 w-1/2 rounded bg-gray-200"></div>
            </div>
            <p class="mt-3 text-xs text-gray-500">Loading...</p>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
        {
            <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
                <svg class="mt-0.5 h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
            </div>
            <p class="mt-3 text-xs text-gray-500">The RC threw, caught it and called <span class="font-mono">SetRequestFailed(ex.Message)</span>. The rest of the page keeps working.</p>
            <button type="button" class="mt-3 rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" @onclick="async () => await _req.InitialRequestAsync()">Try again (fails again)</button>
        }
        else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
        {
            <p class="text-sm text-gray-700">This request never succeeds.</p>
        }
    </div>
</div>
