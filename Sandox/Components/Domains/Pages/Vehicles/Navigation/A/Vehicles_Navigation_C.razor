<div id="@_d.I.ClassName" class="sticky top-0 z-30 bg-amber-400">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="flex items-center gap-3 px-6 py-5 text-sm text-slate-900">
            <svg class="animate-spin w-4 h-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Loading...
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-4 my-3 flex items-start gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            <svg class="w-4 h-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-8">
            <a href="/home" class="text-xl font-black uppercase tracking-tight text-slate-950">@_d.I.Inputs.BrandName</a>

            <nav class="hidden items-center gap-10 lg:flex" aria-label="Main">
                @foreach (var link in _d.I.Inputs.Items)
                {
                    <a href="@link.Href" class="text-base font-medium text-slate-950 decoration-2 underline-offset-8 hover:underline">@link.Label</a>
                }
            </nav>

            <div class="hidden items-center gap-6 lg:flex">
                <span class="text-sm font-semibold text-slate-950">@_d.I.Inputs.Phone</span>
                <a href="/home#calculator"
                   class="inline-flex items-center rounded-full bg-slate-950 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800">
                    Get a quote
                </a>
            </div>

            <button type="button"
                    class="inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-slate-950 text-slate-950 cursor-pointer lg:hidden"
                    aria-label="Menu"
                    @onclick="async () => {
                        _act.ToggleMenu();
                        await _d.StateUpdate();
                    }">
                @if (_act.ShowMobileMenu())
                {
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                }
                else
                {
                    <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                }
            </button>
        </div>

        @if (_act.ShowMobileMenu())
        {
            <div class="border-t border-slate-950/10 px-6 pb-6 pt-2 lg:hidden">
                <nav class="flex flex-col" aria-label="Mobile">
                    @foreach (var link in _d.I.Inputs.Items)
                    {
                        <a href="@link.Href"
                           class="border-b border-slate-950/10 py-4 text-lg font-semibold text-slate-950"
                           @onclick="async () => {
                               _act.CloseMenu();
                               await _d.StateUpdate();
                           }">
                            @link.Label
                        </a>
                    }
                </nav>
                <p class="mt-5 text-sm font-semibold text-slate-950">@_d.I.Inputs.Phone</p>
                <a href="/home#calculator"
                   class="mt-4 flex items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-base font-semibold text-white"
                   @onclick="async () => {
                       _act.CloseMenu();
                       await _d.StateUpdate();
                   }">
                    Get a quote
                </a>
            </div>
        }
    }
</div>
