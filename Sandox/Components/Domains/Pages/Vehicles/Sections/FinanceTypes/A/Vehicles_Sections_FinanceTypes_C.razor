<div id="@_d.I.ClassName" class="bg-white">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="flex items-center justify-center gap-3 p-6 text-sm text-slate-500">
            <svg class="animate-spin w-4 h-4 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            Loading...
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-4 my-3 flex items-start gap-3 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
            <svg class="w-4 h-4 mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <div class="mx-auto max-w-7xl px-6 py-24 md:py-32 lg:px-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-amber-600">Types of vehicle finance</p>
            <h2 class="mt-4 max-w-4xl text-4xl font-black leading-tight tracking-tight text-slate-950 md:text-6xl">
                One lender, every kind of vehicle.
            </h2>

            <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var financeType in _d.I.Inputs.Items)
                {
                    <article class="flex flex-col rounded-3xl bg-slate-50 p-8 ring-1 ring-slate-950/5 md:p-10">
                        <span class="block text-5xl font-black leading-none tracking-tight text-amber-400">0@(financeType.Id)</span>
                        <h3 class="mt-6 text-2xl font-bold tracking-tight text-slate-950">@financeType.Title</h3>
                        <p class="mt-3 text-base text-slate-600">@financeType.Description</p>

                        <ul class="mt-6 flex flex-1 flex-col gap-3 border-t border-slate-200 pt-6">
                            @foreach (var point in financeType.Points)
                            {
                                <li class="flex items-start gap-2 text-sm text-slate-700">
                                    <svg class="mt-0.5 w-4 h-4 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                    </svg>
                                    @point
                                </li>
                            }
                        </ul>

                        <a href="/home#calculator"
                           class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800">
                            Calculate repayments
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                            </svg>
                        </a>
                    </article>
                }
            </div>
        </div>
    }
</div>
