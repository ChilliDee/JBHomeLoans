<div id="@_d.I.ClassName">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="mx-auto h-96 max-w-6xl px-6 py-16"></div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-auto my-8 max-w-xl rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
    <section id="hero" class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-16 lg:grid-cols-2 lg:py-24">
        <div>
            <span class="inline-flex items-center rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-rose-800">Soft. Squishy. Colourful.</span>
            <h1 class="mt-5 text-5xl font-bold leading-tight text-stone-900 sm:text-6xl" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Fluffy balls for every cosy corner.</h1>
            <p class="mt-5 max-w-lg text-lg text-stone-700">Pom-pom balls for shelves, gifts and little hands. Pick a colour and give it a squeeze.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/test#shop" class="rounded-full bg-rose-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700">Shop the fluff</a>
                <a href="/test#gifts" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-rose-700 ring-1 ring-rose-200 transition-colors hover:bg-rose-50">Gift ideas</a>
            </div>
        </div>

        <div class="relative mx-auto h-80 w-full max-w-md" aria-hidden="true">
            <div class="absolute left-2 top-10 h-44 w-44 rounded-full bg-pink-300 shadow-xl ring-8 ring-white/60">
                <span class="absolute left-8 top-6 h-10 w-10 rounded-full bg-white/50 blur-md"></span>
            </div>
            <div class="absolute right-10 top-0 h-32 w-32 rounded-full bg-sky-300 shadow-xl ring-8 ring-white/60">
                <span class="absolute left-6 top-5 h-8 w-8 rounded-full bg-white/50 blur-md"></span>
            </div>
            <div class="absolute bottom-6 right-2 h-28 w-28 rounded-full bg-amber-300 shadow-xl ring-8 ring-white/60">
                <span class="absolute left-5 top-4 h-7 w-7 rounded-full bg-white/50 blur-md"></span>
            </div>
            <div class="absolute bottom-0 left-24 h-36 w-36 rounded-full bg-violet-300 shadow-xl ring-8 ring-white/60">
                <span class="absolute left-7 top-5 h-9 w-9 rounded-full bg-white/50 blur-md"></span>
            </div>
            <div class="absolute right-0 top-32 h-16 w-16 rounded-full bg-emerald-300 shadow-lg ring-4 ring-white/60">
                <span class="absolute left-3 top-2 h-5 w-5 rounded-full bg-white/50 blur-sm"></span>
            </div>
        </div>
    </section>
    }
</div>
