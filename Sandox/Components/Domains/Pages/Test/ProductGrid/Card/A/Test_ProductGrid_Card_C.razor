<div id="@($"{_d.I.ClassName}-{Product.Id}")" class="h-full">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="h-80 animate-pulse rounded-3xl bg-white ring-1 ring-rose-100"></div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <article class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-rose-100 transition-shadow hover:shadow-md">
            <div class="@_switch.Tile(Product.ColourKey)">
                <div class="@_switch.Ball(Product.ColourKey)">
                    <span class="absolute left-5 top-4 h-7 w-7 rounded-full bg-white/50 blur-md"></span>
                </div>
            </div>
            <div class="flex flex-1 flex-col p-5">
                <div class="flex items-start justify-between gap-3">
                    <h3 class="text-lg font-semibold text-stone-900" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">@Product.Name</h3>
                    <span class="text-base font-semibold text-stone-900">@Product.Price.ToString("C2")</span>
                </div>
                <p class="mt-1 text-sm text-stone-700">@Product.Blurb</p>
                <div class="mt-auto flex items-center justify-between pt-5">
                    <span class="rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-medium text-stone-700">@CategoryName</span>
                    <button type="button"
                            disabled="@IsAdding"
                            class="rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                            @onclick="async () => await OnAddToBasket.InvokeAsync(Product.Id)">
                        Add to basket
                    </button>
                </div>
            </div>
        </article>
    }
</div>
