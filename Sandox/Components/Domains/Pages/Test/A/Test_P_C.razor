@page "/test"
@using FE.Components.Domains.Pages.Test.Hero.A
@using FE.Components.Domains.Pages.Test.ProductGrid.A

<PageTitle>Fluffy Balls · Home</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet" />
</HeadContent>

<div id="@_d.I.ClassName" class="min-h-screen bg-orange-50 text-stone-800">
    @if (_d.I.InitialisationCompleted == false || _d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestIsLoading)
    {
        <div class="min-h-screen"></div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasFailed)
    {
        <div class="mx-auto my-8 max-w-xl rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            @_d.RC_Internal.Initialise_HD_.ResponseData.ErrorMessage
        </div>
    }
    else if (_d.RC_Internal.Initialise_HD_.ResponseData.RequestStatus.RequestHasCompleted)
    {
        <!-- Nav -->
        <header class="sticky top-0 z-20 border-b border-rose-100 bg-orange-50/90 backdrop-blur">
            <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                <a href="/test#hero" class="flex items-center gap-2">
                    <span class="relative inline-block h-8 w-8 rounded-full bg-pink-300 ring-2 ring-white">
                        <span class="absolute left-1.5 top-1.5 h-2 w-2 rounded-full bg-white/60"></span>
                    </span>
                    <span class="text-xl font-bold text-rose-700" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Fluffy Balls</span>
                </a>

                <nav aria-label="Main" class="hidden items-center gap-8 text-sm font-medium text-stone-700 sm:flex">
                    <a href="/test#shop" class="transition-colors hover:text-rose-700">Shop</a>
                    <a href="/test#why" class="transition-colors hover:text-rose-700">Why you'll love them</a>
                    <a href="/test#gifts" class="transition-colors hover:text-rose-700">Gifts</a>
                </nav>

                <div class="flex items-center gap-2 rounded-full bg-white px-3 py-2 text-sm font-medium text-stone-700 ring-1 ring-rose-100">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                    <span>Basket</span>
                    <span class="rounded-full bg-rose-600 px-2 py-0.5 text-xs font-semibold text-white">@_act.BasketCount()</span>
                </div>
            </div>
        </header>


        <Test_Hero_C />

        <Test_ProductGrid_C />

        <!-- Why you'll love them -->
        <section id="why" class="bg-white/70 py-16">
            <div class="mx-auto max-w-6xl px-6">
                <h2 class="text-center text-3xl font-bold text-stone-900" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Why you'll love them</h2>
                <div class="mt-10 grid gap-6 md:grid-cols-3">
                    <div class="rounded-3xl bg-orange-50 p-6 ring-1 ring-rose-100">
                        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-rose-100 text-rose-700">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                            </svg>
                        </span>
                        <h3 class="mt-4 text-lg font-semibold text-stone-900" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Soft to squeeze</h3>
                        <p class="mt-1 text-sm text-stone-700">Plush pom-pom fibres that feel great in your hand.</p>
                    </div>
                    <div class="rounded-3xl bg-orange-50 p-6 ring-1 ring-rose-100">
                        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-violet-100 text-violet-700">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />
                            </svg>
                        </span>
                        <h3 class="mt-4 text-lg font-semibold text-stone-900" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Colours that pop</h3>
                        <p class="mt-1 text-sm text-stone-700">Bright and pastel shades to match any room or mood.</p>
                    </div>
                    <div class="rounded-3xl bg-orange-50 p-6 ring-1 ring-rose-100">
                        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-amber-100 text-amber-800">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 1 0 9.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1 1 14.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                            </svg>
                        </span>
                        <h3 class="mt-4 text-lg font-semibold text-stone-900" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Gift ready</h3>
                        <p class="mt-1 text-sm text-stone-700">Pick a few, tie a ribbon, and they're ready to give.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gifts banner -->
        <section id="gifts" class="mx-auto max-w-6xl px-6 py-16">
            <div class="rounded-3xl bg-rose-600 px-8 py-12 text-center text-white">
                <h2 class="text-3xl font-bold" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Need a gift in a hurry?</h2>
                <p class="mx-auto mt-3 max-w-xl text-rose-50">Mix three colours and you have a little cloud of cheer.</p>
                <a href="/test#shop"
                   class="mt-6 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-rose-700 transition-colors hover:bg-rose-50 cursor-pointer"
                   @onclick="async () => { _state.ShowGifts(); await _d.StateUpdate(); }">
                    Browse gifts
                </a>
            </div>
        </section>

        <!-- Footer -->
        <footer class="border-t border-rose-100 py-10 text-center text-sm text-stone-700">
            <p class="font-semibold text-rose-700" style="font-family: Fredoka, ui-rounded, system-ui, sans-serif">Fluffy Balls</p>
            <p class="mt-1">Demo shop. Sample products and prices, nothing here can be bought.</p>
        </footer>
    }
</div>
