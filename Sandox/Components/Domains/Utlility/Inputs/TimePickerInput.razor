@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<script>
    window.setupClickOutsideListener_TimePicker = (wrapperElement, popupElement, dotNetObjectRef) => {
        if (!wrapperElement) return;

        const clickHandler = (event) => {
            const insideWrapper = wrapperElement.contains(event.target);
            const insidePopup = popupElement && popupElement.contains(event.target);
            if (!insideWrapper && !insidePopup) {
                dotNetObjectRef.invokeMethodAsync('ClosePopup');
            }
        };

        document.addEventListener('click', clickHandler, true);
        wrapperElement._tpClickHandler = clickHandler;
    };

    window.removeClickOutsideListener_TimePicker = (wrapperElement) => {
        if (wrapperElement && wrapperElement._tpClickHandler) {
            document.removeEventListener('click', wrapperElement._tpClickHandler, true);
            delete wrapperElement._tpClickHandler;
        }
    };

    window.attachTimePickerPopupToBody = (popupElement, wrapperElement) => {
        if (!popupElement || !wrapperElement) return;

        let hasLoggedAnchor = false;

        const updatePosition = () => {
            if (!document.body.contains(wrapperElement)) return;

            const wrapperRect = wrapperElement.getBoundingClientRect();
            const popupRect = popupElement.getBoundingClientRect();
            const margin = 8;

            // One-time diagnostic so it's easy to confirm in the console
            // which input the popup anchored to, if this ever looks wrong.
            if (!hasLoggedAnchor) {
                hasLoggedAnchor = true;
                console.log('[TimePickerInput] anchoring to wrapper:', wrapperElement, 'rect:', wrapperRect);
            }

            // Clamp horizontally so the popup stays inside the viewport
            let left = wrapperRect.left;
            if (left + popupRect.width > window.innerWidth - margin) {
                left = Math.max(margin, window.innerWidth - popupRect.width - margin);
            }

            // Open downward by default; flip upward if there isn't room below
            // but there is room above
            let top = wrapperRect.bottom + 4;
            const noRoomBelow = top + popupRect.height > window.innerHeight - margin;
            const roomAbove = wrapperRect.top - popupRect.height - 4 > margin;
            if (noRoomBelow && roomAbove) {
                top = wrapperRect.top - popupRect.height - 4;
            }

            popupElement.style.position = 'fixed';
            popupElement.style.top = `${top}px`;
            popupElement.style.left = `${left}px`;
            popupElement.style.zIndex = '9999';
            popupElement.style.margin = '0';
        };

        if (!popupElement._tpOriginalParent) {
            popupElement._tpOriginalParent = popupElement.parentElement;
        }

        if (popupElement.parentElement !== document.body) {
            document.body.appendChild(popupElement);
        }

        // Keep re-measuring for a short "settle" window after opening rather
        // than positioning once. This covers cases where an ancestor (e.g. a
        // sliding sidebar panel) is still mid CSS-transition when the popup
        // attaches - a one-shot measurement would bake in that transient
        // position and never correct itself, since scroll/resize events
        // don't fire during a transform transition.
        const settleUntil = performance.now() + 400;
        const settleLoop = () => {
            updatePosition();
            if (performance.now() < settleUntil) {
                requestAnimationFrame(settleLoop);
            }
        };
        requestAnimationFrame(settleLoop);

        popupElement._tpUpdatePosition = updatePosition;

        window.addEventListener('scroll', updatePosition, true);
        window.addEventListener('resize', updatePosition, true);
    };

    window.detachTimePickerPopupFromBody = (popupElement, wrapperElement) => {
        if (!popupElement) return;

        if (popupElement._tpUpdatePosition) {
            window.removeEventListener('scroll', popupElement._tpUpdatePosition, true);
            window.removeEventListener('resize', popupElement._tpUpdatePosition, true);
            delete popupElement._tpUpdatePosition;
        }

        const targetParent = wrapperElement || popupElement._tpOriginalParent;
        if (targetParent && document.body.contains(targetParent)) {
            targetParent.appendChild(popupElement);
        }

        popupElement.style.position = '';
        popupElement.style.top = '';
        popupElement.style.left = '';
        popupElement.style.zIndex = '';
        popupElement.style.margin = '';

        delete popupElement._tpOriginalParent;
    };
</script>

<div class="relative inline-block" @ref="componentRef">
    <!-- Input Field -->
    <div class="relative">
        <label class="absolute -top-2 left-2 inline-block rounded-lg bg-white px-1 text-xs font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900")">@Label</label>
        <input type="text"
               @onclick="TogglePopup"
               @oninput="OnInputChanged"
               @onblur="OnInputBlur"
               @onfocus="OnInputFocus"
               value="@inputValue"
               placeholder="@Placeholder"
               readonly="@(ReadOnly || IsDisabled)"
               disabled="@IsDisabled"
               class="w-full px-3 py-2 pr-10 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white text-sm @(isInvalid ? "border-red-500 focus:ring-red-500 focus:border-red-500" : "") @(IsDisabled ? "bg-gray-50 text-gray-400 cursor-not-allowed border-gray-200" : "")" />

        <!-- Clock Icon -->
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <svg class="w-5 h-5 @(IsDisabled ? "text-gray-300" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
    </div>

    <!-- Error Message -->
    @if (isInvalid && !string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-1 text-sm text-red-600">@errorMessage</div>
    }

    <!-- Time Popup -->
    @if (ShouldShowPopup)
    {
        <div class="bg-white border border-gray-300 rounded-md shadow-lg p-5 min-w-max @(_popupVisible ? "" : "invisible")" @ref="popupRef">

            <div class="text-sm font-medium text-gray-700 mb-4 text-center">Select Time</div>

            <div class="flex items-center justify-center space-x-3">
                <!-- Hour -->
                <div class="flex flex-col items-center">
                    <button type="button" @onclick="IncrementHour"
                            class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12">
                            <path d="M6 3l3 3H3l3-3z" />
                        </svg>
                    </button>
                    <input type="text"
                           value="@selectedHour"
                           @oninput="OnHourInput"
                           @onblur="ValidateHour"
                           class="w-14 text-center text-sm border border-gray-300 rounded-md py-2 my-2 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                           maxlength="2" />
                    <button type="button" @onclick="DecrementHour"
                            class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12">
                            <path d="M6 9L3 6h6l-3 3z" />
                        </svg>
                    </button>
                    <div class="text-xs text-gray-400 mt-1">@(Use12HourFormat ? "Hour" : "HH")</div>
                </div>

                <div class="text-2xl font-bold text-gray-600 pb-6">:</div>

                <!-- Minute -->
                <div class="flex flex-col items-center">
                    <button type="button" @onclick="IncrementMinute"
                            class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12">
                            <path d="M6 3l3 3H3l3-3z" />
                        </svg>
                    </button>
                    <input type="text"
                           value="@selectedMinute"
                           @oninput="OnMinuteInput"
                           @onblur="ValidateMinute"
                           class="w-14 text-center text-sm border border-gray-300 rounded-md py-2 my-2 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500"
                           maxlength="2" />
                    <button type="button" @onclick="DecrementMinute"
                            class="w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12">
                            <path d="M6 9L3 6h6l-3 3z" />
                        </svg>
                    </button>
                    <div class="text-xs text-gray-400 mt-1">MM</div>
                </div>

                <!-- AM/PM -->
                @if (Use12HourFormat)
                {
                    <div class="flex flex-col items-center gap-2 pb-6">
                        <button type="button" @onclick="@(() => SetAmPm("AM"))"
                                class="px-3 py-2 text-sm rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-accent-500 @(selectedAmPm == "AM" ? "bg-accent-600 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-700")">
                            AM
                        </button>
                        <button type="button" @onclick="@(() => SetAmPm("PM"))"
                                class="px-3 py-2 text-sm rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-accent-500 @(selectedAmPm == "PM" ? "bg-accent-600 text-white" : "bg-gray-100 hover:bg-gray-200 text-gray-700")">
                            PM
                        </button>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 pt-3 border-t border-gray-200 flex gap-2">
                <button type="button" @onclick="SelectNow"
                        class="flex-1 px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-400">
                    Now
                </button>
                <button type="button" @onclick="Confirm"
                        class="flex-1 px-3 py-2 text-sm bg-accent-600 text-white rounded-md hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-500">
                    Done
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public TimeSpan? Value { get; set; }
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
    [Parameter] public Func<Task>? AsyncCallBack { get; set; }
    [Parameter] public Action? CallBack { get; set; }
    [Parameter] public bool Use12HourFormat { get; set; } = false;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Label { get; set; } = "Time";

    [Parameter] public bool Required { get; set; } = false;

    /// <summary>
    /// Pass your code-behind AddValidator method here. The component registers
    /// its own Validate method into your list on initialisation.
    /// </summary>
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationRef { get; set; }

    private string Placeholder => Use12HourFormat ? "hh:mm AM/PM" : "HH:mm";
    private string TimeFormat => Use12HourFormat ? "hh:mm tt" : "HH:mm";

    private bool isPopupOpen = false;
    private ElementReference componentRef;
    private ElementReference popupRef;
    private DotNetObjectReference<TimePickerInput>? dotNetRef;
    private string inputValue = "";
    private bool isInvalid = false;
    private string errorMessage = "";
    private bool isUserTyping = false;
    private bool isDisposed = false;
    private bool _popupAttached = false;
    private bool _popupVisible = false;

    private string selectedHour = "12";
    private string selectedMinute = "00";
    private string selectedAmPm = "AM";

    private bool IsDisabled => Disabled;

    // Single source of truth for whether the popup should be mounted - used
    // both in the markup and in the body-portal attach/detach logic so they
    // can never disagree.
    private bool ShouldShowPopup => isPopupOpen && !IsDisabled;

    protected override void OnInitialized()
    {

        if (Value.HasValue)
            SyncFromValue();

        dotNetRef = DotNetObjectReference.Create(this);
        ValidationRef?.Invoke(Validate);
    }

    protected override void OnParametersSet()
    {
        if (!isUserTyping)
        {
            if (Value.HasValue)
            {
                SyncFromValue();
                inputValue = TimeOnly.FromTimeSpan(Value.Value).ToString(TimeFormat);
            }
            else
            {
                inputValue = "";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isDisposed) return;

        // --- Body portal: attach popup to <body> when opening ---
        if (ShouldShowPopup && !_popupAttached)
        {
            try
            {
                _popupVisible = false;

                await Task.Delay(50); // let Blazor finish patching the DOM before measuring it

                // The popup may have been closed again while we were
                // waiting (e.g. rapid open/close clicks) - bail out rather
                // than attaching one that should no longer be open.
                if (!ShouldShowPopup) return;

                await JSRuntime.InvokeVoidAsync("setupClickOutsideListener_TimePicker", componentRef, popupRef, dotNetRef);
                await JSRuntime.InvokeVoidAsync("attachTimePickerPopupToBody", popupRef, componentRef);

                _popupAttached = true;
                _popupVisible = true;
                StateHasChanged();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        // --- Body portal: detach popup from <body> when closing ---
        else if (!ShouldShowPopup && _popupAttached)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("detachTimePickerPopupFromBody", popupRef, componentRef);
                await JSRuntime.InvokeVoidAsync("removeClickOutsideListener_TimePicker", componentRef);

                _popupAttached = false;
                _popupVisible = false;
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }

    [JSInvokable]
    public async Task ClosePopup()
    {
        if (isDisposed) return;

        if (isPopupOpen)
        {
            isPopupOpen = false;
            await InvokeAsync(StateHasChanged);
            await FireCallbacks();
        }
    }

    private async Task FireCallbacks()
    {
        await Task.Yield();
        if (AsyncCallBack is not null) await AsyncCallBack();
        CallBack?.Invoke();
    }

    private void SyncFromValue()
    {
        if (!Value.HasValue) return;

        var time = TimeOnly.FromTimeSpan(Value.Value);

        if (Use12HourFormat)
        {
            selectedHour = time.ToString("hh");
            selectedAmPm = time.Hour >= 12 ? "PM" : "AM";
        }
        else
        {
            selectedHour = time.ToString("HH");
        }

        selectedMinute = time.ToString("mm");
    }

    private void TogglePopup()
    {
        if (!ReadOnly && !IsDisabled)
        {
            isPopupOpen = !isPopupOpen;
            if (isPopupOpen && Value.HasValue)
                SyncFromValue();
        }
    }

    private void OnInputFocus()
    {
        if (IsDisabled) return;
        isUserTyping = true;
        ClearValidationError();
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        if (ReadOnly || IsDisabled) return;
        inputValue = e.Value?.ToString() ?? "";
        isUserTyping = true;
        ClearValidationError();
    }

    private async Task OnInputBlur()
    {
        if (IsDisabled) return;
        isUserTyping = false;
        await ValidateAndSetTime();
    }

    private async Task ValidateAndSetTime()
    {
        if (string.IsNullOrWhiteSpace(inputValue))
        {
            await SetValue(null);
            ClearValidationError();
            return;
        }

        var formats24 = new[] { "HH:mm", "H:mm", "H:m", "HH:m" };
        var formats12 = new[] { "hh:mm tt", "h:mm tt", "hh:mm TT", "h:mm TT", "hh:mmtt", "h:mmtt" };
        var formats = Use12HourFormat ? formats12 : formats24;

        TimeOnly parsed;
        bool isValid = false;

        foreach (var fmt in formats)
        {
            if (TimeOnly.TryParseExact(inputValue, fmt, out parsed))
            {
                isValid = true;
                await SetValue(parsed.ToTimeSpan());
                inputValue = parsed.ToString(TimeFormat);
                SyncFromValue();
                ClearValidationError();
                return;
            }
        }

        // Fallback: try general parse
        if (DateTime.TryParse(inputValue, out var dt))
        {
            parsed = TimeOnly.FromDateTime(dt);
            await SetValue(parsed.ToTimeSpan());
            inputValue = parsed.ToString(TimeFormat);
            SyncFromValue();
            ClearValidationError();
            return;
        }

        SetValidationError($"Please enter a valid time in {Placeholder} format");
    }

    // ── Spinner Handlers ──────────────────────────────────────────────────────

    private void OnHourInput(ChangeEventArgs e) => selectedHour = e.Value?.ToString() ?? selectedHour;
    private void OnMinuteInput(ChangeEventArgs e) => selectedMinute = e.Value?.ToString() ?? selectedMinute;

    private void IncrementHour()
    {
        var hour = ParseHour();
        var maxHour = Use12HourFormat ? 12 : 23;
        var minHour = Use12HourFormat ? 1 : 0;
        hour = hour >= maxHour ? minHour : hour + 1;
        selectedHour = hour.ToString("00");
        UpdateInputFromSpinners();
    }

    private void DecrementHour()
    {
        var hour = ParseHour();
        var maxHour = Use12HourFormat ? 12 : 23;
        var minHour = Use12HourFormat ? 1 : 0;
        hour = hour <= minHour ? maxHour : hour - 1;
        selectedHour = hour.ToString("00");
        UpdateInputFromSpinners();
    }

    private void IncrementMinute()
    {
        var minute = ParseMinute();
        minute = minute >= 59 ? 0 : minute + 1;
        selectedMinute = minute.ToString("00");
        UpdateInputFromSpinners();
    }

    private void DecrementMinute()
    {
        var minute = ParseMinute();
        minute = minute <= 0 ? 59 : minute - 1;
        selectedMinute = minute.ToString("00");
        UpdateInputFromSpinners();
    }

    private void ValidateHour()
    {
        var maxHour = Use12HourFormat ? 12 : 23;
        var minHour = Use12HourFormat ? 1 : 0;
        var hour = ParseHour();
        hour = Math.Clamp(hour, minHour, maxHour);
        selectedHour = hour.ToString("00");
        UpdateInputFromSpinners();
    }

    private void ValidateMinute()
    {
        var minute = Math.Clamp(ParseMinute(), 0, 59);
        selectedMinute = minute.ToString("00");
        UpdateInputFromSpinners();
    }

    private void SetAmPm(string amPm)
    {
        selectedAmPm = amPm;
        UpdateInputFromSpinners();
    }

    private void UpdateInputFromSpinners()
    {
        if (Use12HourFormat)
            inputValue = $"{selectedHour}:{selectedMinute} {selectedAmPm}";
        else
            inputValue = $"{selectedHour}:{selectedMinute}";

        // Update the bound value live so the parent always has the current spinner state
        var time = BuildTimeFromSpinners();
        if (time is not null)
            InvokeAsync(async () => await SetValue(time.Value.ToTimeSpan()));
    }

    // ── Action Buttons ────────────────────────────────────────────────────────

    private async Task Confirm()
    {
        var time = BuildTimeFromSpinners();
        if (time is null) return;

        await SetValue(time.Value.ToTimeSpan());
        inputValue = time.Value.ToString(TimeFormat);
        ClearValidationError();
        isPopupOpen = false;
        await FireCallbacks();
    }

    private async Task SelectNow()
    {
        var now = TimeOnly.FromDateTime(DateTime.Now);
        await SetValue(now.ToTimeSpan());
        inputValue = now.ToString(TimeFormat);
        SyncFromValue();
        ClearValidationError();
        isPopupOpen = false;
        await FireCallbacks();
    }

    private TimeOnly? BuildTimeFromSpinners()
    {
        var hour = ParseHour();
        var minute = ParseMinute();

        if (Use12HourFormat)
        {
            if (selectedAmPm == "PM" && hour != 12) hour += 12;
            else if (selectedAmPm == "AM" && hour == 12) hour = 0;
        }

        if (hour < 0 || hour > 23 || minute < 0 || minute > 59)
            return null;

        return new TimeOnly(hour, minute);
    }

    private int ParseHour() => int.TryParse(selectedHour, out var h) ? h : (Use12HourFormat ? 12 : 0);
    private int ParseMinute() => int.TryParse(selectedMinute, out var m) ? m : 0;

    // ── Value ─────────────────────────────────────────────────────────────────

    private async Task SetValue(TimeSpan? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(Value);
    }

    private void ClearValidationError()
    {
        isInvalid = false;
        errorMessage = "";
    }

    private (bool IsValid, string Label) Validate()
    {
        if (Required && !Value.HasValue)
        {
            isInvalid = true;
            errorMessage = "This field is required";
            StateHasChanged();
            return (false, Label);
        }

        isInvalid = false;
        errorMessage = "";
        StateHasChanged();
        return (true, Label);
    }

    private void SetValidationError(string message)
    {
        isInvalid = true;
        errorMessage = message;
    }

    // ── Disposal ──────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (isDisposed) return;
        isDisposed = true;

        try
        {
            if (componentRef.Id != null)
            {
                await JSRuntime.InvokeVoidAsync("removeClickOutsideListener_TimePicker", componentRef);

                if (_popupAttached)
                    await JSRuntime.InvokeVoidAsync("detachTimePickerPopupFromBody", popupRef, componentRef);
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }

        dotNetRef?.Dispose();
    }
}
