@using Microsoft.AspNetCore.Components
@using System.Globalization
@implements IDisposable


<div class="relative">
    <label for="@Id" class="absolute -top-2 left-2 inline-block rounded-lg bg-white px-1 text-xs font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900") z-10">
        @Label
    </label>
    <div class="relative">
        <span class="absolute left-3 top-1/2 transform -translate-y-1/2 @(IsDisabled ? "text-gray-300" : "text-gray-500") text-sm z-10">@CurrencySymbol</span>
        <input type="text"
               name="@Name"
               id="@Id"
               value="@GetDisplayValue()"
               disabled="@IsDisabled"
               @onchange="HandleChange"
               @onfocus="HandleFocus"
               @onblur="HandleBlur"
               class="@GetInputClasses()"
               placeholder="@Placeholder" />
    </div>
    @if (isInvalid && !string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-1 text-xs text-red-600">@errorMessage</div>
    }
    else if (Disabled && !string.IsNullOrWhiteSpace(DisabledMessage))
    {
        <div class="mt-1 text-xs text-gray-500 italic">@DisabledMessage</div>
    }
</div>

@code {

    [Parameter] public decimal? Value { get; set; }
    [Parameter] public Func<Task>? AsyncCallBack { get; set; }
    [Parameter] public Action? CallBack { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "0.00";
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public int DecimalPlaces { get; set; } = 2;
    [Parameter] public bool AllowNull { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string? DisabledMessage { get; set; }
    [Parameter] public bool Highlight { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;

    /// <summary>
    /// Pass your code-behind AddValidator method here. The component registers
    /// its own Validate method into your list on initialisation.
    /// </summary>
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationRef { get; set; }

    /// <summary>
    /// Pass your code-behind RemoveValidator method here. The component removes
    /// its own Validate method from your list on dispose.
    /// </summary>
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationUnref { get; set; }

    /// <summary>
    /// Runs every time the value changes. Return (false, "error message") to show an inline error.
    /// Does not participate in the ValidationRef flow.
    /// </summary>
    [Parameter] public Func<Task<(bool IsValid, string ErrorMessage)>>? OnChangeValidation { get; set; }

    /// <summary>
    /// Debounce delay in milliseconds for OnChangeValidation. Defaults to 300ms.
    /// </summary>
    [Parameter] public int OnChangeValidationDebounceMs { get; set; } = 300;

    /// <summary>
    /// Runs as part of the ValidationRef flow when ValidateAll() is called.
    /// Return (false, "error message") to fail validation.
    /// </summary>
    [Parameter] public Func<Task<(bool IsValid, string ErrorMessage)>>? CustomValidation { get; set; }

    private bool isEditing = false;
    private CancellationTokenSource? _onChangeValidationCts;
    private bool isInvalid = false;
    private string errorMessage = string.Empty;

    private bool IsDisabled => Disabled;

    protected override void OnInitialized()
    {
        ValidationRef?.Invoke(Validate);
        base.OnInitialized();
    }

    private (bool IsValid, string Label) Validate()
    {
        if (Required && Value is null)
        {
            isInvalid = true;
            errorMessage = "This field is required";
            StateHasChanged();
            return (false, Label);
        }

        if (Value is not null && CustomValidation != null)
        {
            var result = CustomValidation().GetAwaiter().GetResult();
            if (!result.IsValid)
            {
                isInvalid = true;
                errorMessage = result.ErrorMessage;
                StateHasChanged();
                return (false, Label);
            }
        }

        isInvalid = false;
        errorMessage = string.Empty;
        StateHasChanged();
        return (true, Label);
    }

    private string GetInputClasses()
    {
        var baseClasses = "border-none block w-full rounded-md pl-8 pr-3 py-1.5 text-base outline-1 -outline-offset-1 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 sm:text-sm/6 relative";

        if (IsDisabled)
            return $"{baseClasses} bg-gray-50 text-gray-500 outline-gray-200 cursor-not-allowed";

        if (Highlight)
            return $"{baseClasses} text-gray-900 outline-amber-400 focus:outline-amber-600";

        if (isInvalid)
            return $"{baseClasses} bg-white text-gray-900 outline-red-500 focus:outline-red-500";

        return $"{baseClasses} bg-white text-gray-900 outline-gray-300 focus:outline-accent-600";
    }

    private string GetDisplayValue()
    {
        if (Value == null) return string.Empty;

        if (isEditing && !IsDisabled)
            return Value.ToString() ?? string.Empty;

        return Value.Value.ToString($"N{DecimalPlaces}", CultureInfo.CurrentCulture);
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (IsDisabled) return;

        var stringValue = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(stringValue))
        {
            Value = AllowNull ? null : 0;
            await ValueChanged.InvokeAsync(Value);
            await InvokeCallbacks();
            await RunOnChangeValidationAsync();
            return;
        }

        var cleanValue = CleanValueForParsing(stringValue);

        if (string.IsNullOrWhiteSpace(cleanValue))
            Value = AllowNull ? null : 0;
        else if (decimal.TryParse(cleanValue, NumberStyles.Number, CultureInfo.CurrentCulture, out var parsedValue))
            Value = parsedValue;
        else if (Value == null)
            Value = AllowNull ? null : 0;

        if (Value is not null)
        {
            isInvalid = false;
            errorMessage = string.Empty;
        }

        await ValueChanged.InvokeAsync(Value);
        await InvokeCallbacks();
        await RunOnChangeValidationAsync();
    }

    private async Task RunOnChangeValidationAsync()
    {
        if (OnChangeValidation == null) return;

        _onChangeValidationCts?.Cancel();
        _onChangeValidationCts = new CancellationTokenSource();
        var token = _onChangeValidationCts.Token;

        try
        {
            await Task.Delay(OnChangeValidationDebounceMs, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        var result = await OnChangeValidation();
        if (!result.IsValid)
        {
            isInvalid = true;
            errorMessage = result.ErrorMessage;
        }
        else
        {
            isInvalid = false;
            errorMessage = string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task InvokeCallbacks()
    {
        if (AsyncCallBack != null)
            await AsyncCallBack();

        CallBack?.Invoke();
    }

    private string CleanValueForParsing(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        return value
            .Replace(CurrencySymbol, "")
            .Replace(",", "")
            .Replace(" ", "")
            .Trim();
    }

    private void HandleFocus()
    {
        if (IsDisabled) return;
        isEditing = true;
        StateHasChanged();
    }

    private void HandleBlur()
    {
        if (IsDisabled) return;
        isEditing = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        ValidationUnref?.Invoke(Validate);
        _onChangeValidationCts?.Cancel();
        _onChangeValidationCts?.Dispose();
    }
}
