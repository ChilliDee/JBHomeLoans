@using Microsoft.AspNetCore.Components
@implements IDisposable

<div class="relative">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="absolute -top-2 left-2 inline-block rounded-lg bg-white px-1 text-xs font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900") z-10">
            @Label
        </label>
    }

    <div class="block w-full rounded-md @(IsDisabled ? "bg-gray-50" : "") @GetContainerBorderCss() py-1.5 px-1">
        @if (Items == null || !Items.Any())
        {
            <p class="text-sm text-gray-400 px-1">No options available.</p>
        }
        else
        {
            <div class="flex flex-col gap-2">
                @for (var i = 0; i < Items.Count; i++)
                {
                    var index = i;
                    var item = Items[index];
                    <div class="@GetRowCss(index)"
                         @onclick="async () => {
                                                 if (!IsDisabled)
                                                 {
                                                     await SelectItemAsync(index);
                                                 }
                                             }">
                    <span class="text-sm font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900")">@item.Description</span>
                    @if (_selectedIndex == index)
                    {
                        <svg class="w-4 h-4 text-accent-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_isInvalid)
{
    <div class="mt-1 text-xs text-red-600">This field is required</div>
}
</div>

@code {

    [Parameter] public List<SelectableListInputOption> Items { get; set; } = new();
    [Parameter] public SelectableListInputOption? Value { get; set; }
    [Parameter] public EventCallback<SelectableListInputOption?> ValueChanged { get; set; }
    [Parameter] public Func<Task>? AsyncCallBack { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationRef { get; set; }

    private int? _selectedIndex;
    private bool _initialised = false;
    private bool _isInvalid = false;

    private bool IsDisabled => Disabled;

    protected override void OnInitialized()
    {

        if (Required && ValidationRef != null)
        {
            ValidationRef(() => Validate());
        }

        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (!_initialised)
        {
            _selectedIndex = ResolveInitialIndex(Value);
            _initialised = true;
        }
    }

    private int? ResolveInitialIndex(SelectableListInputOption? value)
    {
        if (value == null || Items == null) return null;

        // Match by reference first (handles null/duplicate Ids cleanly),
        // then fall back to Id match for cases where a fresh instance was passed in.
        var refIndex = Items.IndexOf(value);
        if (refIndex >= 0) return refIndex;

        if (value.Id.HasValue)
        {
            var idIndex = Items.FindIndex(i => i.Id == value.Id);
            if (idIndex >= 0) return idIndex;
        }

        return null;
    }

    private (bool IsValid, string Label) Validate()
    {
        if (Required && _selectedIndex == null)
        {
            _isInvalid = true;
            StateHasChanged();
            return (false, Label);
        }

        _isInvalid = false;
        StateHasChanged();
        return (true, Label);
    }

    private async Task SelectItemAsync(int index)
    {
        int? newIndex = _selectedIndex == index ? null : index;
        _selectedIndex = newIndex;

        SelectableListInputOption? newValue = newIndex.HasValue ? Items[newIndex.Value] : null;
        Value = newValue;

        if (_isInvalid && _selectedIndex != null)
        {
            _isInvalid = false;
        }

        await ValueChanged.InvokeAsync(newValue);

        if (AsyncCallBack != null)
            await AsyncCallBack.Invoke();
    }

    private string GetContainerBorderCss()
    {
        if (_isInvalid)
            return "border border-red-500 rounded-md";

        return "border border-gray-200 rounded-md";
    }

    private string GetRowCss(int index)
    {
        var selected = _selectedIndex == index;
        var baseClasses = "flex items-center justify-between p-3 rounded-lg border transition-colors";

        if (IsDisabled)
            return selected
                ? $"{baseClasses} border-accent-200 bg-accent-50 cursor-not-allowed opacity-60"
                : $"{baseClasses} border-gray-200 bg-gray-50 cursor-not-allowed opacity-60";

        return selected
            ? $"{baseClasses} border-accent-400 bg-accent-50 cursor-pointer"
            : $"{baseClasses} border-gray-200 hover:bg-gray-50 cursor-pointer";
    }

    public void Dispose()
    {
    }

    public class SelectableListInputOption
    {
        public SelectableListInputOption(int? id, string description)
        {
            Id = id;
            Description = description;
        }

        public int? Id { get; set; }
        public string Description { get; set; } = string.Empty;
    }
}
