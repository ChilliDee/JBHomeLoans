@using Microsoft.AspNetCore.Components
@implements IDisposable

<div class="relative h-full w-full">
    <div class="relative w-full h-full">
        <button type="button"
                id="@Id"
                name="@Name"
                disabled="@IsDisabled"
                @onclick="ToggleDropdown"
                @onfocusout="HandleFocusOut"
                class="@GetButtonClasses()">
            <span class="@(SelectedOption == null ? (IsDisabled ? "text-gray-300" : "text-gray-400") : (IsDisabled ? "text-gray-500" : ""))">
                @if (SelectedOption != null)
                {
                    @SelectedOption.Value
                }
                else
                {
                    @Placeholder
                }
            </span>
        </button>

        <div class="absolute right-2 top-1/2 transform -translate-y-1/2 pointer-events-none">
            <svg class="size-5 @(IsDisabled ? "text-gray-300" : "text-gray-400")" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
        </div>
    </div>

    @if (isOpen && !IsDisabled)
    {
        <ul class="absolute z-50 mt-1 max-h-[240px] overflow-auto bg-white py-1 text-base shadow-lg ring-1 ring-black/5 focus:outline-hidden sm:text-sm min-w-full"
            style="width: max-content; min-width: 100%;"
            tabindex="-1"
            role="listbox"
            aria-labelledby="@Id">

            @if (Options?.Any() == true)
            {
                @foreach (var option in Options)
                {
                    <li class="relative cursor-default py-2 pr-4 pl-8 text-gray-900 select-none cursor-pointer hover:bg-gray-100"
                        role="option"
                        @onclick="() => SelectOption(option)"
                        @onmousedown:preventDefault="true">
                        <span class="block truncate font-normal">
                            @option.Value
                        </span>
                        @if (SelectedOption?.Value == option.Value)
                        {
                            <span class="absolute inset-y-0 left-0 flex items-center pl-1.5 text-indigo-600">
                                <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"></path>
                                </svg>
                            </span>
                        }
                    </li>
                }
            }
            else
            {
                <li class="px-3 py-2 text-gray-500 text-center">
                    No options available
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public TableSingleSelectDropDownOption? SelectedOption { get; set; }
    [Parameter] public IEnumerable<TableSingleSelectDropDownOption> Options { get; set; } = null!;
    [Parameter] public EventCallback<TableSingleSelectDropDownOption?> AsyncCallBack { get; set; }
    [Parameter] public Action<TableSingleSelectDropDownOption?>? OnChange { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "Select...";
    [Parameter] public EventCallback<TableSingleSelectDropDownOption?> SelectedOptionChanged { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;

    private bool isOpen = false;

    public class TableSingleSelectDropDownOption
    {
        public TableSingleSelectDropDownOption(string? value, int? id = null)
        {
            Id = id;
            Value = value ?? string.Empty;
        }

        public int? Id { get; set; }
        public string Value { get; set; } = string.Empty;
    }

    private bool IsDisabled => Disabled;

    protected override void OnInitialized()
    {

        base.OnInitialized();
    }

    private string GetButtonClasses()
    {
        var baseClasses = "block w-full h-full px-3 py-1.5 text-base sm:text-sm/6 border-0 outline-none focus:outline-none focus:ring-0 focus:border-0 text-left";

        if (IsDisabled)
        {
            return $"{baseClasses} bg-gray-50 text-gray-500 cursor-not-allowed";
        }
        else
        {
            return $"{baseClasses} bg-white text-gray-900 cursor-pointer";
        }
    }

    private async Task SelectOption(TableSingleSelectDropDownOption option)
    {
        if (IsDisabled) return; // Don't process when disabled

        SelectedOption = option;
        isOpen = false;

        // Notify parent of the change for two-way binding
        await SelectedOptionChanged.InvokeAsync(option);

        // Additional callbacks
        OnChange?.Invoke(option);
        await AsyncCallBack.InvokeAsync(option);
    }

    private void ToggleDropdown()
    {
        if (IsDisabled) return; // Don't toggle when disabled

        isOpen = !isOpen;
    }

    private async Task HandleFocusOut(FocusEventArgs e)
    {
        if (IsDisabled) return; // Don't handle focus out when disabled

        // Small delay to allow click events to fire first
        await Task.Delay(150);
        isOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        // Unsubscribe from PropertyChanged events to prevent memory leaks
    }
}