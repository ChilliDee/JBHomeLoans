@using Microsoft.AspNetCore.Components
@using System.Globalization
@implements IDisposable

<div class="relative">
    <label for="@Id" class="absolute -top-2 left-2 inline-block rounded-lg bg-white px-1 text-xs font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900") z-10">
        @Label
    </label>
    <div class="relative">
        <input type="text"
               name="@Name"
               id="@Id"
               value="@GetDisplayValue()"
               disabled="@IsDisabled"
               @onchange="HandleChange"
               @onfocus="HandleFocus"
               @onblur="HandleBlur"
               class="@GetInputClasses()"
               placeholder="@Placeholder" />
        <span class="absolute right-2 top-1/2 transform -translate-y-1/2 @(IsDisabled ? "text-gray-300" : "text-gray-500") text-sm z-10">%</span>
    </div>
</div>

@code {
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public Func<Task>? AsyncCallBack { get; set; }
    [Parameter] public Action? CallBack { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "0.00";
    [Parameter] public int DecimalPlaces { get; set; } = 2;
    [Parameter] public bool AllowNull { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;

    private bool isEditing = false;

    private bool IsDisabled => Disabled;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private string GetInputClasses()
    {
        var baseClasses = "border-none block w-full rounded-md pl-3 pr-6 py-1.5 text-base outline-1 -outline-offset-1 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 sm:text-sm/6 relative";

        if (IsDisabled)
        {
            return $"{baseClasses} bg-gray-50 text-gray-500 outline-gray-200 cursor-not-allowed";
        }
        else
        {
            return $"{baseClasses} bg-white text-gray-900 outline-gray-300 focus:outline-accent-600";
        }
    }

    private string GetDisplayValue()
    {
        if (Value == null) return string.Empty;

        if (isEditing && !IsDisabled)
            return Value.ToString() ?? string.Empty;

        return Value.Value.ToString($"N{DecimalPlaces}", CultureInfo.CurrentCulture);
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (IsDisabled) return;

        var stringValue = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(stringValue))
        {
            Value = AllowNull ? null : 0;
            await ValueChanged.InvokeAsync(Value);
            await InvokeCallbacks();
            return;
        }

        var cleanValue = CleanValueForParsing(stringValue);

        if (string.IsNullOrWhiteSpace(cleanValue))
        {
            Value = AllowNull ? null : 0;
        }
        else if (decimal.TryParse(cleanValue, NumberStyles.Number, CultureInfo.CurrentCulture, out var parsedValue))
        {
            Value = Math.Clamp(parsedValue, 0, 100);
        }
        else
        {
            if (Value == null)
            {
                Value = AllowNull ? null : 0;
            }
        }

        await ValueChanged.InvokeAsync(Value);
        await InvokeCallbacks();
    }

    private async Task InvokeCallbacks()
    {
        if (AsyncCallBack != null)
            await AsyncCallBack();

        CallBack?.Invoke();
    }

    private string CleanValueForParsing(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        return value
            .Replace("%", "")
            .Replace(",", "")
            .Replace(" ", "")
            .Trim();
    }

    private void HandleFocus()
    {
        if (IsDisabled) return;
        isEditing = true;
        StateHasChanged();
    }

    private void HandleBlur()
    {
        if (IsDisabled) return;
        isEditing = false;
        StateHasChanged();
    }

    public void Dispose()
    {
    }
}
