@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Globalization
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="relative inline-block w-full" @ref="wrapperRef">
    <!-- Input Field -->
    <div class="relative">
        <label for="@_instanceId" class="absolute -top-2 left-2 inline-block rounded-lg bg-white px-1 text-xs font-medium @(IsDisabled ? "text-gray-400" : "text-gray-900")">@Label</label>
        @* Open/close, month+year navigation, day-grid rendering, and the time controls
           (spinners/typed hour+minute/AM-PM) are all owned by JS (DTP.init) — nothing
           round-trips through the server for any of it. Typing in the main field is a plain
           uncontrolled input (no @oninput binding). The ONLY server calls left are: a
           date/time actually being picked or changed, and the typed text being committed once
           focus truly leaves the widget — both of which need .NET's existing parsing/validation
           and ValueChanged/AsyncCallBack/CallBack/Value plumbing. *@
        <input type="text"
               id="@_instanceId"
               @ref="mainInputRef"
               placeholder="@Placeholder"
               readonly="@(ReadOnly || IsDisabled)"
               disabled="@IsDisabled"
               class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 bg-white text-sm @(isInvalid ? "border-red-500 focus:ring-red-500 focus:border-red-500" : "") @(IsDisabled ? "bg-gray-50 text-gray-400 cursor-not-allowed border-gray-200" : "")" />

        <!-- Calendar Icon -->
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <svg class="w-5 h-5 @(IsDisabled ? "text-gray-300" : "text-gray-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
    </div>

    <!-- Error Message -->
    @if (isInvalid && !string.IsNullOrEmpty(errorMessage))
    {
        <div class="mt-1 text-sm text-red-600">
            @errorMessage
        </div>
    }

    @* Always rendered (hidden by default) so JS has a stable element to attach to the body and
       populate. Everything inside — month/year header, day grid, time controls, action buttons —
       is built by JS on open/navigate. *@
    <div class="bg-white border border-gray-300 rounded-md shadow-lg p-4 min-w-max"
         style="display:none;"
         @ref="calendarRef">
    </div>
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public EventCallback AsyncCallBack { get; set; }
    [Parameter] public Action? CallBack { get; set; }
    [Parameter] public string Placeholder { get; set; } = "dd/MM/yyyy";

    /// <summary>
    /// Optional. Used only as a readable prefix for the generated instance id. Does NOT need to
    /// be unique — uniqueness is guaranteed internally via a GUID suffix. The JS module keys its
    /// instance dictionary off this id, so a collision would let one picker's open/close hijack
    /// another's.
    /// </summary>
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public string DateFormat { get; set; } = "dd/MM/yyyy";
    [Parameter] public string Label { get; set; } = "Date";
    [Parameter] public bool IncludeTime { get; set; } = false;
    [Parameter] public bool Use12HourFormat { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;

    /// <summary>
    /// Pass your code-behind AddValidator method here. The component registers
    /// its own Validate method into your list on initialisation.
    /// </summary>
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationRef { get; set; }

    /// <summary>
    /// Pass your code-behind RemoveValidator method here. The component removes
    /// its own Validate method from your list on dispose.
    /// </summary>
    [Parameter] public Action<Func<(bool IsValid, string Label)>>? ValidationUnref { get; set; }

    // -------------------------------------------------------------------------
    // Private state
    // -------------------------------------------------------------------------

    private ElementReference wrapperRef;
    private ElementReference calendarRef;
    private ElementReference mainInputRef;
    private DotNetObjectReference<DateTimePicker>? dotNetRef;
    private string inputValue = "";
    private bool isInvalid = false;
    private string errorMessage = "";
    private bool isDisposed = false;
    private bool _initialised = false;
    private DateTime? _previousMinDate;
    private DateTime? _previousMaxDate;

    // Guaranteed-unique key for this instance — used for the DOM id/for attribute and every
    // DTP.* JS call. Generated once per component instance so it survives re-renders.
    private string _instanceId = string.Empty;

    private bool IsDisabled => Disabled;

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override void OnInitialized()
    {
        _instanceId = string.IsNullOrWhiteSpace(Id)
            ? $"dtp-{Guid.NewGuid():N}"
            : $"{Id}-{Guid.NewGuid():N}";

        if (IncludeTime && DateFormat == "dd/MM/yyyy")
        {
            DateFormat = Use12HourFormat ? "dd/MM/yyyy hh:mm tt" : "dd/MM/yyyy HH:mm";
            if (Placeholder == "dd/MM/yyyy")
                Placeholder = Use12HourFormat ? "dd/MM/yyyy hh:mm AM/PM" : "dd/MM/yyyy HH:mm";
        }

        if (Value.HasValue)
        {
            inputValue = Value.Value.ToString(DateFormat);
        }

        _previousMinDate = MinDate;
        _previousMaxDate = MaxDate;

        dotNetRef = DotNetObjectReference.Create(this);
        ValidationRef?.Invoke(Validate);
    }

    private (bool IsValid, string Label) Validate()
    {
        if (isDisposed) return (true, Label);

        if (Required && !Value.HasValue)
        {
            isInvalid = true;
            errorMessage = "This field is required";
            StateHasChanged();
            return (false, Label);
        }

        if (Value.HasValue && !IsDateSelectable(Value.Value.Date))
        {
            isInvalid = true;
            errorMessage = GetDateRangeError(Value.Value);
            StateHasChanged();
            return (false, Label);
        }

        isInvalid = false;
        errorMessage = "";
        StateHasChanged();
        return (true, Label);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isDisposed) return;

        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("DTP.init", _instanceId, mainInputRef, calendarRef, wrapperRef, BuildInitPayload(), dotNetRef);
                _initialised = true;
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }

    // -------------------------------------------------------------------------
    // JS-invokable — the only paths back to .NET from user interaction.
    // -------------------------------------------------------------------------

    // A day/Today/Now was picked in the calendar. isoDateTime is 'yyyy-MM-dd' (date-only mode)
    // or 'yyyy-MM-ddTHH:mm:ss' (IncludeTime), already combined with the current time controls by JS.
    [JSInvokable]
    public async Task OnDateSelected(string isoDateTime)
    {
        if (isDisposed) return;

        if (!TryParseIso(isoDateTime, out var date)) return;
        if (!IsDateSelectable(date.Date)) return;

        await SetValue(date);
        inputValue = date.ToString(DateFormat);
        ClearValidationError();
        await InvokeAsync(StateHasChanged);
    }

    // A time control changed (spinner click, typed hour/minute committed on focusout, AM/PM
    // toggle) while a date was already selected. JS has already recombined date+time client-side.
    [JSInvokable]
    public async Task OnTimeChanged(string isoDateTime)
    {
        if (isDisposed) return;
        if (!TryParseIso(isoDateTime, out var date)) return;

        await SetValue(date);
        inputValue = date.ToString(DateFormat);
        await InvokeAsync(StateHasChanged);
    }

    // The typed text in the main field was committed (blur/Escape/click-elsewhere/tab-away).
    [JSInvokable]
    public async Task OnCommit(string typedValue)
    {
        if (isDisposed) return;

        inputValue = typedValue ?? "";
        await ValidateAndSetDate();
        await InvokeAsync(StateHasChanged);
    }

    private static bool TryParseIso(string isoDateTime, out DateTime date)
    {
        return DateTime.TryParseExact(isoDateTime, "yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture, DateTimeStyles.None, out date)
            || DateTime.TryParseExact(isoDateTime, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date);
    }

    // -------------------------------------------------------------------------
    // Date parsing & setting (typed-text path — unchanged parsing rules)
    // -------------------------------------------------------------------------

    private async Task ValidateAndSetDate()
    {
        if (string.IsNullOrWhiteSpace(inputValue))
        {
            await SetValue(null);
            ClearValidationError();
            return;
        }

        var dateFormats = new[] { "dd/MM/yyyy", "d/M/yyyy", "dd/M/yyyy", "d/MM/yyyy", "dd-MM-yyyy", "d-M-yyyy" };
        var dateTimeFormats = new[] {
            "dd/MM/yyyy HH:mm", "d/M/yyyy HH:mm", "dd/M/yyyy HH:mm", "d/MM/yyyy HH:mm",
            "dd/MM/yyyy hh:mm tt", "d/M/yyyy hh:mm tt", "dd/M/yyyy hh:mm tt", "d/MM/yyyy hh:mm tt",
            "dd-MM-yyyy HH:mm", "d-M-yyyy HH:mm"
        };

        var formats = IncludeTime ? dateTimeFormats : dateFormats;
        DateTime parsedDate = DateTime.MinValue;
        bool isValidDate = false;

        foreach (var format in formats)
        {
            if (DateTime.TryParseExact(inputValue, format, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedDate))
            {
                isValidDate = true;
                break;
            }
        }

        if (!isValidDate)
            isValidDate = DateTime.TryParse(inputValue, out parsedDate);

        if (isValidDate)
        {
            if (IsDateSelectable(parsedDate.Date))
            {
                // Committing the same value that's already set (e.g. a blur fired by clicking
                // away after a guard reverted the picker) must not re-fire ValueChanged/AsyncCallBack —
                // callers may treat every callback invocation as a genuine change (save, re-validate, etc).
                if (Value != parsedDate)
                {
                    await SetValue(parsedDate);
                }
                inputValue = parsedDate.ToString(DateFormat);
                ClearValidationError();
            }
            else
            {
                SetValidationError(GetDateRangeError(parsedDate));
            }
        }
        else
        {
            var expectedFormat = IncludeTime ? (Use12HourFormat ? "dd/MM/yyyy hh:mm AM/PM" : "dd/MM/yyyy HH:mm") : "dd/MM/yyyy";
            SetValidationError($"Please enter a valid date in {expectedFormat} format");
        }
    }

    private async Task SetValue(DateTime? newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(Value);
        await AsyncCallBack.InvokeAsync();
        CallBack?.Invoke();
    }

    // -------------------------------------------------------------------------
    // Validation
    // -------------------------------------------------------------------------

    private void ClearValidationError()
    {
        isInvalid = false;
        errorMessage = "";
    }

    private void SetValidationError(string message)
    {
        isInvalid = true;
        errorMessage = message;
    }

    private string GetDateRangeError(DateTime date)
    {
        if (MinDate.HasValue && date < MinDate.Value.Date)
            return $"Date must be on or after {MinDate.Value.ToString(DateFormat)}";
        if (MaxDate.HasValue && date > MaxDate.Value.Date)
            return $"Date must be on or before {MaxDate.Value.ToString(DateFormat)}";
        return "Date is not within the allowed range";
    }

    private bool IsDateSelectable(DateTime date)
    {
        if (MinDate.HasValue && date < MinDate.Value.Date) return false;
        if (MaxDate.HasValue && date > MaxDate.Value.Date) return false;
        return true;
    }

    // -------------------------------------------------------------------------
    // JS payload building
    // -------------------------------------------------------------------------

    private string[] GetDaysOfWeek()
    {
        var culture = CultureInfo.CurrentCulture;
        var dayNames = new string[7];
        var firstDayOfWeek = (int)culture.DateTimeFormat.FirstDayOfWeek;
        for (int i = 0; i < 7; i++)
        {
            var dayOfWeek = (DayOfWeek)((firstDayOfWeek + i) % 7);
            dayNames[i] = culture.DateTimeFormat.GetAbbreviatedDayName(dayOfWeek);
        }
        return dayNames;
    }

    private object BuildInitPayload()
    {
        string? hour = null, minute = null, ampm = null;
        if (Value.HasValue && IncludeTime)
        {
            hour = Use12HourFormat ? Value.Value.ToString("hh") : Value.Value.ToString("HH");
            minute = Value.Value.ToString("mm");
            ampm = Use12HourFormat ? Value.Value.ToString("tt") : null;
        }

        return new
        {
            minDate = MinDate?.ToString("yyyy-MM-dd"),
            maxDate = MaxDate?.ToString("yyyy-MM-dd"),
            dateFormat = DateFormat,
            value = Value?.ToString("yyyy-MM-dd"),
            today = DateTime.Today.ToString("yyyy-MM-dd"),
            firstDayOfWeek = (int)CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek,
            dayNames = GetDaysOfWeek(),
            monthNames = Enumerable.Range(1, 12).Select(m => CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)).ToArray(),
            includeTime = IncludeTime,
            use12HourFormat = Use12HourFormat,
            hour,
            minute,
            ampm,
            readOnly = ReadOnly,
            disabled = IsDisabled
        };
    }

    // -------------------------------------------------------------------------
    // Parameter sync — pushes external Value/MinDate/MaxDate changes into JS.
    // -------------------------------------------------------------------------

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var newValue = parameters.GetValueOrDefault<DateTime?>(nameof(Value));
        var newMinDate = parameters.GetValueOrDefault<DateTime?>(nameof(MinDate));
        var newMaxDate = parameters.GetValueOrDefault<DateTime?>(nameof(MaxDate));

        var valueChanged = newValue != Value;
        var constraintsChanged = newMinDate != _previousMinDate || newMaxDate != _previousMaxDate;

        _previousMinDate = newMinDate;
        _previousMaxDate = newMaxDate;

        if (valueChanged)
        {
            inputValue = newValue?.ToString(DateFormat) ?? "";
        }

        await base.SetParametersAsync(parameters);

        if (_initialised && (valueChanged || constraintsChanged))
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("DTP.updateOptions", _instanceId, BuildInitPayload());
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }

        if (valueChanged)
        {
            StateHasChanged();
        }
    }

    // -------------------------------------------------------------------------
    // Dispose
    // -------------------------------------------------------------------------

    public async ValueTask DisposeAsync()
    {
        if (isDisposed) return;
        isDisposed = true;

        ValidationUnref?.Invoke(Validate);

        try { await JSRuntime.InvokeVoidAsync("DTP.dispose", _instanceId); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }

        dotNetRef?.Dispose();
        dotNetRef = null;
    }
}

<script>
    // DTP = Date Time Picker. One module, one instance per component (keyed by the
    // guaranteed-unique instance id passed from .NET). Open/close, month+year navigation,
    // day-grid rendering, and all time controls (spinners/typed hour+minute/AM-PM) are client-
    // side. The ONLY times this talks back to .NET are: a date/time actually being picked or
    // changed, and the typed text in the main field being committed once focus truly leaves the
    // widget — paths that genuinely need server-side parsing/validation/callback logic.
    window.DTP = window.DTP || (function() {
        const instances = {};

        function esc(s) {
            return (s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function pad2(n) { return String(n).padStart(2, '0'); }

        // Greedy longest-match tokenizer for .NET-style custom date/time format strings
        // (yyyy, MM, dd, HH, hh, mm, tt, etc). Walking the format character-by-character avoids
        // the ordering pitfalls of sequential string.replace() (e.g. "mm" vs "MM" clobbering).
        function formatDateTime(inst, isoDate, format) {
            if (!isoDate) return '';
            const [y, mo, d] = isoDate.split('-').map(Number);

            let h24 = 0, minute = 0, ampm = 'AM';
            if (inst.includeTime) {
                const hourNum = parseInt(inst.hour, 10) || 0;
                minute = parseInt(inst.minute, 10) || 0;
                if (inst.use12HourFormat) {
                    ampm = inst.ampm;
                    h24 = ampm === 'PM' ? (hourNum === 12 ? 12 : hourNum + 12) : (hourNum === 12 ? 0 : hourNum);
                } else {
                    h24 = hourNum;
                    ampm = h24 < 12 ? 'AM' : 'PM';
                }
            }
            const h12 = h24 % 12 === 0 ? 12 : h24 % 12;

            const tokens = [
                ['yyyy', String(y)], ['yy', String(y).slice(-2)],
                ['MM', pad2(mo)], ['M', String(mo)],
                ['dd', pad2(d)], ['d', String(d)],
                ['HH', pad2(h24)], ['H', String(h24)],
                ['hh', pad2(h12)], ['h', String(h12)],
                ['mm', pad2(minute)], ['m', String(minute)],
                ['tt', ampm]
            ].sort((a, b) => b[0].length - a[0].length);

            let result = '', i = 0;
            outer:
            while (i < format.length) {
                for (const [token, value] of tokens) {
                    if (format.startsWith(token, i)) {
                        result += value;
                        i += token.length;
                        continue outer;
                    }
                }
                result += format[i];
                i++;
            }
            return result;
        }

        function isSelectable(inst, isoDate) {
            if (inst.minDate && isoDate < inst.minDate) return false;
            if (inst.maxDate && isoDate > inst.maxDate) return false;
            return true;
        }

        function buildDays(inst) {
            const { year, month } = inst.cursor;
            const firstOfMonth = new Date(year, month - 1, 1);
            const jsDow = firstOfMonth.getDay();
            const offset = (jsDow - inst.firstDayOfWeek + 7) % 7;
            const start = new Date(year, month - 1, 1 - offset);

            const days = [];
            for (let i = 0; i < 42; i++) {
                const dt = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
                const iso = `${dt.getFullYear()}-${pad2(dt.getMonth() + 1)}-${pad2(dt.getDate())}`;
                days.push({
                    iso,
                    day: dt.getDate(),
                    isCurrentMonth: (dt.getMonth() + 1) === month && dt.getFullYear() === year,
                    isSelected: inst.selectedDate === iso,
                    isToday: inst.today === iso,
                    selectable: isSelectable(inst, iso)
                });
            }
            return days;
        }

        function dayClasses(day) {
            let classes = "w-8 h-8 text-sm rounded-full flex items-center justify-center transition-colors ";
            if (!day.isCurrentMonth) {
                classes += "text-gray-300 cursor-not-allowed ";
            } else if (!day.selectable) {
                classes += "text-gray-400 cursor-not-allowed ";
            } else {
                classes += "hover:bg-accent-100 cursor-pointer ";
                if (day.isSelected) classes += "bg-accent-600 text-white hover:bg-accent-700 ";
                else if (day.isToday) classes += "bg-accent-100 text-accent-600 font-semibold ";
                else classes += "text-gray-900 ";
            }
            return classes.trim();
        }

        function yearOptions(inst) {
            let latest = inst.maxDate ? Number(inst.maxDate.slice(0, 4)) : Number(inst.today.slice(0, 4));
            let earliest = inst.minDate ? Number(inst.minDate.slice(0, 4)) : (Number(inst.today.slice(0, 4)) - 100);
            latest = Math.max(latest, inst.cursor.year);
            earliest = Math.min(earliest, inst.cursor.year);

            const years = [];
            for (let y = latest; y >= earliest; y--) years.push(y);
            return years;
        }

        function render(inst) {
            const days = buildDays(inst);
            let html = '';

            html += '<div class="flex items-center justify-between mb-4">'
                + '<button type="button" data-role="prev" class="p-1 hover:bg-gray-100 rounded">'
                + '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>'
                + '</button>'
                + '<div class="flex items-center gap-2 font-semibold text-gray-900">'
                + '<span>' + esc(inst.monthNames[inst.cursor.month - 1]) + '</span>'
                + '<select data-role="year" class="border border-gray-300 rounded-md text-sm py-1 pl-2 pr-6 bg-white focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500">'
                + yearOptions(inst).map(y => '<option value="' + y + '"' + (y === inst.cursor.year ? ' selected' : '') + '>' + y + '</option>').join('')
                + '</select>'
                + '</div>'
                + '<button type="button" data-role="next" class="p-1 hover:bg-gray-100 rounded">'
                + '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>'
                + '</button>'
                + '</div>';

            html += '<div class="grid grid-cols-7 gap-1 mb-2">';
            inst.dayNames.forEach(dn => { html += '<div class="text-center text-sm font-medium text-gray-500 py-2">' + esc(dn) + '</div>'; });
            html += '</div>';

            html += '<div class="grid grid-cols-7 gap-1">';
            days.forEach(day => {
                const disabled = (!day.isCurrentMonth || !day.selectable) ? 'disabled' : '';
                html += '<button type="button" data-role="day" data-date="' + day.iso + '" ' + disabled + ' class="' + dayClasses(day) + '">' + day.day + '</button>';
            });
            html += '</div>';

            if (inst.includeTime) {
                html += '<div class="mt-4 pt-4 border-t border-gray-200">'
                    + '<div class="text-sm font-medium text-gray-700 mb-3 text-center">Select Time</div>'
                    + '<div class="flex items-center justify-center space-x-3">'
                    + '<div class="flex flex-col items-center">'
                    + '<button type="button" data-role="hour-up" class="w-8 h-8 text-sm bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><path d="M6 3l3 3H3l3-3z" /></svg></button>'
                    + '<input type="text" data-role="hour-input" value="' + esc(inst.hour) + '" maxlength="2" class="w-14 text-center text-sm border border-gray-300 rounded-md py-2 my-2 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500" />'
                    + '<button type="button" data-role="hour-down" class="w-8 h-8 text-sm bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><path d="M6 9L3 6h6l-3 3z" /></svg></button>'
                    + '</div>'
                    + '<div class="text-2xl font-bold text-gray-600 pt-2">:</div>'
                    + '<div class="flex flex-col items-center">'
                    + '<button type="button" data-role="minute-up" class="w-8 h-8 text-sm bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><path d="M6 3l3 3H3l3-3z" /></svg></button>'
                    + '<input type="text" data-role="minute-input" value="' + esc(inst.minute) + '" maxlength="2" class="w-14 text-center text-sm border border-gray-300 rounded-md py-2 my-2 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500" />'
                    + '<button type="button" data-role="minute-down" class="w-8 h-8 text-sm bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition-colors"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><path d="M6 9L3 6h6l-3 3z" /></svg></button>'
                    + '</div>';

                if (inst.use12HourFormat) {
                    html += '<div class="flex flex-col items-center justify-center ml-2">'
                        + '<button type="button" data-role="ampm" class="px-3 py-2 text-sm bg-accent-100 hover:bg-accent-200 text-accent-800 rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-accent-500">' + esc(inst.ampm) + '</button>'
                        + '</div>';
                }

                html += '</div></div>';
            }

            html += '<div class="mt-4 pt-3 border-t border-gray-200 flex space-x-2">';
            if (inst.includeTime) {
                html += '<button type="button" data-role="now" class="flex-1 px-3 py-2 text-sm bg-green-600 text-white rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500">Now</button>';
            }
            html += '<button type="button" data-role="today" class="flex-1 px-3 py-2 text-sm bg-accent-600 text-white rounded-md hover:bg-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-500">Today</button>';
            html += '</div>';

            inst.calendarEl.innerHTML = html;
        }

        function updatePosition(inst) {
            if (!document.body.contains(inst.wrapperEl)) return;

            const wrapperRect = inst.wrapperEl.getBoundingClientRect();
            const calRect = inst.calendarEl.getBoundingClientRect();
            const margin = 8;

            let left = wrapperRect.left;
            if (left + calRect.width > window.innerWidth - margin) {
                left = Math.max(margin, window.innerWidth - calRect.width - margin);
            }

            let top = wrapperRect.bottom + 4;
            const noRoomBelow = top + calRect.height > window.innerHeight - margin;
            const roomAbove = wrapperRect.top - calRect.height - 4 > margin;
            if (noRoomBelow && roomAbove) {
                top = wrapperRect.top - calRect.height - 4;
            }

            inst.calendarEl.style.position = 'fixed';
            inst.calendarEl.style.top = top + 'px';
            inst.calendarEl.style.left = left + 'px';
            inst.calendarEl.style.zIndex = '9999';
            inst.calendarEl.style.margin = '0';
        }

        function attachToBody(inst) {
            if (!inst.calendarEl._dtpOriginalParent) inst.calendarEl._dtpOriginalParent = inst.calendarEl.parentElement;
            if (inst.calendarEl.parentElement !== document.body) document.body.appendChild(inst.calendarEl);

            inst.calendarEl.style.display = 'block';

            // A short settle loop: the very first frame after insertion can report a stale
            // getBoundingClientRect before layout has caught up, so we re-measure for a few
            // frames. Entirely client-side — no round trip, no perceptible delay.
            const settleUntil = performance.now() + 200;
            const loop = () => {
                updatePosition(inst);
                if (performance.now() < settleUntil) requestAnimationFrame(loop);
            };
            requestAnimationFrame(loop);

            inst._posHandler = () => updatePosition(inst);
            window.addEventListener('scroll', inst._posHandler, true);
            window.addEventListener('resize', inst._posHandler, true);
        }

        function detachFromBody(inst) {
            if (inst._posHandler) {
                window.removeEventListener('scroll', inst._posHandler, true);
                window.removeEventListener('resize', inst._posHandler, true);
                inst._posHandler = null;
            }

            const parent = inst.calendarEl._dtpOriginalParent;
            if (parent && document.body.contains(parent)) parent.appendChild(inst.calendarEl);

            Object.assign(inst.calendarEl.style, { position: '', top: '', left: '', zIndex: '', margin: '', display: 'none' });
        }

        function open(id) {
            const inst = instances[id];
            if (!inst || inst.isOpen || inst.disabled || inst.readOnly) return;

            inst.isOpen = true;
            inst.cursor = inst.selectedDate
                ? { year: Number(inst.selectedDate.slice(0, 4)), month: Number(inst.selectedDate.slice(5, 7)) }
                : { year: Number(inst.today.slice(0, 4)), month: Number(inst.today.slice(5, 7)) };

            render(inst);
            attachToBody(inst);
        }

        function close(id) {
            const inst = instances[id];
            if (!inst || !inst.isOpen) return;

            inst.isOpen = false;
            detachFromBody(inst);
        }

        function toggle(id) {
            const inst = instances[id];
            if (!inst) return;
            inst.isOpen ? close(id) : open(id);
        }

        function forceClose(id) {
            close(id);
        }

        function commit(id) {
            const inst = instances[id];
            if (!inst) return;
            close(id);
            inst.dotNetRef.invokeMethodAsync('OnCommit', inst.inputEl.value);
        }

        function setMainInputDisplay(inst) {
            inst.inputEl.value = inst.selectedDate ? formatDateTime(inst, inst.selectedDate, inst.dateFormat) : '';
        }

        function notifyDateSelected(inst) {
            const iso = inst.includeTime
                ? inst.selectedDate + 'T' + isoTime(inst)
                : inst.selectedDate;
            inst.dotNetRef.invokeMethodAsync('OnDateSelected', iso);
        }

        function notifyTimeChanged(inst) {
            if (!inst.selectedDate) return; // matches original: time-only changes are no-ops until a date exists
            const iso = inst.selectedDate + 'T' + isoTime(inst);
            inst.dotNetRef.invokeMethodAsync('OnTimeChanged', iso);
        }

        function isoTime(inst) {
            const hourNum = parseInt(inst.hour, 10) || 0;
            const minute = parseInt(inst.minute, 10) || 0;
            let h24 = hourNum;
            if (inst.use12HourFormat) {
                h24 = inst.ampm === 'PM' ? (hourNum === 12 ? 12 : hourNum + 12) : (hourNum === 12 ? 0 : hourNum);
            }
            return pad2(h24) + ':' + pad2(minute) + ':00';
        }

        function chooseDate(id, isoDate) {
            const inst = instances[id];
            if (!inst) return;

            const day = buildDays(inst).find(d => d.iso === isoDate);
            if (!day || !day.isCurrentMonth || !day.selectable) return;

            inst.selectedDate = isoDate;
            setMainInputDisplay(inst);
            close(id);
            notifyDateSelected(inst);
        }

        function chooseToday(id) {
            const inst = instances[id];
            if (!isSelectable(inst, inst.today)) return;
            chooseDate(id, inst.today);
        }

        function chooseNow(id) {
            const inst = instances[id];
            if (!inst) return;
            if (!isSelectable(inst, inst.today)) return;

            const now = new Date();
            const h24 = now.getHours();
            if (inst.use12HourFormat) {
                inst.hour = String(h24 % 12 === 0 ? 12 : h24 % 12);
                inst.ampm = h24 < 12 ? 'AM' : 'PM';
            } else {
                inst.hour = pad2(h24);
            }
            inst.minute = pad2(now.getMinutes());
            inst.selectedDate = inst.today;

            setMainInputDisplay(inst);
            close(id);
            notifyDateSelected(inst);
        }

        function navigate(id, delta) {
            const inst = instances[id];
            if (!inst || !inst.isOpen) return;

            let { year, month } = inst.cursor;
            month += delta;
            if (month < 1) { month = 12; year -= 1; }
            else if (month > 12) { month = 1; year += 1; }
            inst.cursor = { year, month };
            render(inst);
            attachToBody(inst); // re-measure — content height/width may have changed
        }

        function onYearChange(id, year) {
            const inst = instances[id];
            if (!inst) return;
            inst.cursor = { year: Number(year), month: inst.cursor.month };
            render(inst);
            attachToBody(inst);
        }

        function spin(id, kind, direction) {
            const inst = instances[id];
            if (!inst) return;

            let current = parseInt(kind === 'hour' ? inst.hour : inst.minute, 10);
            if (isNaN(current)) current = kind === 'hour' ? (inst.use12HourFormat ? 12 : 0) : 0;

            if (kind === 'hour') {
                const maxHour = inst.use12HourFormat ? 12 : 23;
                const minHour = inst.use12HourFormat ? 1 : 0;
                current += direction;
                if (current > maxHour) current = minHour;
                if (current < minHour) current = maxHour;
                inst.hour = pad2(current);
            } else {
                current += direction;
                if (current > 59) current = 0;
                if (current < 0) current = 59;
                inst.minute = pad2(current);
            }

            const input = inst.calendarEl.querySelector('[data-role="' + kind + '-input"]');
            if (input) input.value = kind === 'hour' ? inst.hour : inst.minute;

            setMainInputDisplay(inst);
            notifyTimeChanged(inst);
        }

        function toggleAmPm(id) {
            const inst = instances[id];
            if (!inst) return;

            inst.ampm = inst.ampm === 'AM' ? 'PM' : 'AM';
            const btn = inst.calendarEl.querySelector('[data-role="ampm"]');
            if (btn) btn.textContent = inst.ampm;

            setMainInputDisplay(inst);
            notifyTimeChanged(inst);
        }

        function commitTypedHourOrMinute(id, kind, rawValue) {
            const inst = instances[id];
            if (!inst) return;

            let value = parseInt(rawValue, 10);
            if (kind === 'hour') {
                if (isNaN(value)) value = inst.use12HourFormat ? 12 : 0;
                const maxHour = inst.use12HourFormat ? 12 : 23;
                const minHour = inst.use12HourFormat ? 1 : 0;
                if (value < minHour) value = minHour;
                if (value > maxHour) value = maxHour;
                inst.hour = pad2(value);
            } else {
                if (isNaN(value)) value = 0;
                if (value < 0) value = 0;
                if (value > 59) value = 59;
                inst.minute = pad2(value);
            }

            const input = inst.calendarEl.querySelector('[data-role="' + kind + '-input"]');
            if (input) input.value = kind === 'hour' ? inst.hour : inst.minute;

            setMainInputDisplay(inst);
            notifyTimeChanged(inst);
        }

        function onCalendarClick(id, e) {
            const btn = e.target.closest('button[data-role]');
            if (!btn) return;

            switch (btn.dataset.role) {
                case 'prev': navigate(id, -1); break;
                case 'next': navigate(id, 1); break;
                case 'day': if (!btn.disabled) chooseDate(id, btn.dataset.date); break;
                case 'today': chooseToday(id); break;
                case 'now': chooseNow(id); break;
                case 'hour-up': spin(id, 'hour', 1); break;
                case 'hour-down': spin(id, 'hour', -1); break;
                case 'minute-up': spin(id, 'minute', 1); break;
                case 'minute-down': spin(id, 'minute', -1); break;
                case 'ampm': toggleAmPm(id); break;
            }
        }

        function onCalendarChange(id, e) {
            if (e.target.dataset && e.target.dataset.role === 'year') {
                onYearChange(id, e.target.value);
            }
        }

        // focusout bubbles (unlike blur), so this single delegated listener catches the
        // hour/minute inputs being left, even though they're rebuilt on every render().
        function onCalendarFocusOut(id, e) {
            const target = e.target;
            if (!target || !target.dataset) return;

            if (target.dataset.role === 'hour-input') {
                commitTypedHourOrMinute(id, 'hour', target.value);
            } else if (target.dataset.role === 'minute-input') {
                commitTypedHourOrMinute(id, 'minute', target.value);
            }
        }

        function init(id, inputEl, calendarEl, wrapperEl, options, dotNetRef) {
            dispose(id); // re-init safe

            const inst = {
                inputEl, calendarEl, wrapperEl, dotNetRef,
                minDate: options.minDate ?? null,
                maxDate: options.maxDate ?? null,
                dateFormat: options.dateFormat,
                selectedDate: options.value ?? null,
                today: options.today,
                firstDayOfWeek: options.firstDayOfWeek,
                dayNames: options.dayNames,
                monthNames: options.monthNames,
                includeTime: !!options.includeTime,
                use12HourFormat: !!options.use12HourFormat,
                hour: options.hour ?? (options.use12HourFormat ? '12' : '00'),
                minute: options.minute ?? '00',
                ampm: options.ampm ?? 'AM',
                readOnly: !!options.readOnly,
                disabled: !!options.disabled,
                isOpen: false,
                cursor: { year: Number(options.today.slice(0, 4)), month: Number(options.today.slice(5, 7)) }
            };
            instances[id] = inst;

            setMainInputDisplay(inst);

            inst._clickHandler = () => toggle(id);
            inst._keydownHandler = e => {
                if (e.key === 'Escape') { e.preventDefault(); commit(id); }
                else if (e.key === 'Enter') { e.preventDefault(); commit(id); inputEl.blur(); }
            };
            // Prevent calendar interactions from stealing focus from the input, so focusout
            // below only ever fires for genuine "user left the whole widget" cases. The native
            // <select> for year is deliberately excluded — preventing its mousedown breaks
            // opening the OS-native dropdown in some browsers, and it's a real focusable form
            // control anyway, so we let it behave natively.
            inst._calendarMouseDownHandler = e => {
                if (e.target && e.target.tagName === 'SELECT') return;
                if (e.target && e.target.closest && e.target.closest('[data-role="hour-input"], [data-role="minute-input"]')) return;
                e.preventDefault();
            };
            inst._calendarClickHandler = e => onCalendarClick(id, e);
            inst._calendarChangeHandler = e => onCalendarChange(id, e);
            inst._calendarFocusOutHandler = e => onCalendarFocusOut(id, e);
            inst._focusOutHandler = () => {
                setTimeout(() => {
                    if (!document.body.contains(wrapperEl)) return;
                    const active = document.activeElement;
                    const stillInside = wrapperEl.contains(active) || (inst.isOpen && calendarEl.contains(active));
                    if (!stillInside) commit(id);
                }, 150);
            };

            inputEl.addEventListener('click', inst._clickHandler);
            inputEl.addEventListener('keydown', inst._keydownHandler);
            inputEl.addEventListener('focusout', inst._focusOutHandler);
            calendarEl.addEventListener('mousedown', inst._calendarMouseDownHandler);
            calendarEl.addEventListener('click', inst._calendarClickHandler);
            calendarEl.addEventListener('change', inst._calendarChangeHandler);
            calendarEl.addEventListener('focusout', inst._calendarFocusOutHandler);
        }

        function updateOptions(id, options) {
            const inst = instances[id];
            if (!inst) return;

            inst.minDate = options.minDate ?? null;
            inst.maxDate = options.maxDate ?? null;
            inst.selectedDate = options.value ?? null;
            inst.readOnly = !!options.readOnly;
            inst.disabled = !!options.disabled;
            if (options.hour != null) inst.hour = options.hour;
            if (options.minute != null) inst.minute = options.minute;
            if (options.ampm != null) inst.ampm = options.ampm;

            setMainInputDisplay(inst);
            if (inst.isOpen) { render(inst); attachToBody(inst); }
        }

        function dispose(id) {
            const inst = instances[id];
            if (!inst) return;

            inst.inputEl.removeEventListener('click', inst._clickHandler);
            inst.inputEl.removeEventListener('keydown', inst._keydownHandler);
            inst.inputEl.removeEventListener('focusout', inst._focusOutHandler);
            inst.calendarEl.removeEventListener('mousedown', inst._calendarMouseDownHandler);
            inst.calendarEl.removeEventListener('click', inst._calendarClickHandler);
            inst.calendarEl.removeEventListener('change', inst._calendarChangeHandler);
            inst.calendarEl.removeEventListener('focusout', inst._calendarFocusOutHandler);

            if (inst.isOpen) detachFromBody(inst);

            delete instances[id];
        }

        return { init, open, close, toggle, forceClose, updateOptions, dispose };
    })();
</script>
