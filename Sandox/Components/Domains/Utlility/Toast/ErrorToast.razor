@* Reusable Error Toast Component *@
<div class="fixed top-4 right-4 max-w-md rounded-md shadow-lg bg-red-50 ring-1 ring-red-200 z-50 p-4">
    <div class="flex items-start gap-3">    
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5">
            <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z" clip-rule="evenodd" />
        </svg>
        <div class="flex-1 min-w-0">
            <h3 class="text-sm font-medium text-red-800 whitespace-normal break-words">@Title</h3>
            <p class="mt-1 text-sm text-red-700 whitespace-normal break-words overflow-wrap-anywhere">@Message</p>
            <button @onclick="OnDismiss" class="mt-2 text-sm font-medium text-red-600 hover:text-red-500">
                Dismiss
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public EventCallback OnDismiss { get; set; }
}