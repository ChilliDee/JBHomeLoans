<iframe class="pdf-viewer" srcdoc="@_html" style="width:100%; height:100%; border:none;"></iframe>

@code {
    [Parameter] public byte[] FileBytes { get; set; }
    private string _html;

    protected override void OnParametersSet()
    {
        try
        {
            if (FileBytes is { Length: > 0 })
            {
                _html = System.Text.Encoding.UTF8.GetString(FileBytes);
            }
        }
        catch (Exception)
        {
            _html = @"<div style='height: 97vh;
                        width: 100vh;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: .75rem;
                        font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji''>This file cannot be previewed</div>";
        }
    }
}