@inject IJSRuntime JS
@if (isVisible)
{
    <div class="fixed inset-0 z-40"></div>
    <div id="draggable-@componentId"
         class="fixed bg-white rounded-lg shadow-2xl border border-gray-300 overflow-hidden z-50"
         style="width: @(Width != null ? Width + "px" : "600px"); min-width: @(MinWidth != null ? MinWidth + "px" : ""); max-width: calc(100vw - 150px); height: calc(100vh - 50px); @(StartCentered ? "left: 50%; top: 50%; transform: translate(-50%, -50%);" : $"left: {InitialX}px; top: {InitialY}px;")"
         @ref="draggableElement">
        <div class="h-full flex flex-col">
            <div id="draggable-header-@componentId"
                 class="bg-accent-600 px-4 py-3 cursor-move select-none flex items-center justify-between rounded-t-lg flex-shrink-0">
                <h3 class="text-white font-semibold text-base">@Title</h3>
                <div class="flex items-center gap-2">
                    @if (ShowMaximizeButton)
                    {
                        <button @onclick="ToggleMaximize"
                                class="text-white hover:text-gray-200 transition-colors cursor-default"
                                type="button">
                            @if (isMaximized)
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <rect x="8" y="8" width="12" height="12" rx="1" stroke-width="2" />
                                    <rect x="4" y="4" width="12" height="12" rx="1" stroke-width="2" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <rect x="4" y="4" width="16" height="16" rx="1" stroke-width="2" />
                                </svg>
                            }
                        </button>
                    }
                    @if (ShowCloseButton)
                    {
                        <button @onclick="Close"
                                class="text-white hover:text-gray-200 transition-colors cursor-default"
                                type="button">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    }
                </div>
            </div>
            <div class="flex-1 min-h-0 @OverflowYAuto [&_img]:max-w-full [&_img]:h-auto">
                @ChildContent
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public bool StartCentered { get; set; } = false;
    [Parameter] public int? Width { get; set; }
    [Parameter] public string? OverflowYAuto { get; set; } = "overflow-y-auto";
    [Parameter] public bool ShowMaximizeButton { get; set; } = false;
    private bool isMaximized = false;
    private async Task ToggleMaximize()
    {
        isMaximized = await JS.InvokeAsync<bool>("toggleMaximizeDraggable", componentId);
    }
}