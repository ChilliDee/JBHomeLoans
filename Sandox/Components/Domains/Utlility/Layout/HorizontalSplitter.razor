<div @ref="_containerRef"
     class="grid h-full flex-1 w-full min-h-0 min-w-0"
     style="grid-template-columns: @($"{CurrentPct}fr {SplitterWidthPx}px {100 - CurrentPct}fr");">

    @* Left cell *@
    <div class="min-w-0 min-h-0 overflow-hidden flex flex-col h-full">
        @Left
    </div>

    @* Splitter handle — CHANGED *@
    <div @ref="_handleRef"
         class="@SplitterClass cursor-col-resize flex items-center justify-center group rounded-xl cursor-pointer"
         style="touch-action: none;">
        <svg class="text-gray-500 group-hover:text-white transition-colors pointer-events-none"
             width="4" height="20" viewBox="0 0 4 20" fill="currentColor"
             xmlns="http://www.w3.org/2000/svg">
            <circle cx="2" cy="2" r="1" />
            <circle cx="2" cy="10" r="1" />
            <circle cx="2" cy="18" r="1" />
        </svg>
    </div>

    @* Right cell *@
    <div class="min-w-0 min-h-0 flex flex-col overflow-hidden h-full">
        @Right
    </div>
</div>