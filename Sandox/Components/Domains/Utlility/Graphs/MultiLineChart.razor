@* MultiLineChart.razor *@

<div class="bg-white overflow-hidden">

    <!-- Header and Period Toggle -->
    <div class="px-6 py-4 bg-white border-b border-gray-200">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold text-gray-900">@Title</h2>
            <div class="flex rounded-lg border border-gray-300 overflow-hidden">
                <button type="button" class="@GetToggleButtonClass(TimePeriod.Day)" @onclick="() => SetTimePeriod(TimePeriod.Day)">Day</button>
                <button type="button" class="@GetToggleButtonClass(TimePeriod.Week)" @onclick="() => SetTimePeriod(TimePeriod.Week)">Week</button>
                <button type="button" class="@GetToggleButtonClass(TimePeriod.Month)" @onclick="() => SetTimePeriod(TimePeriod.Month)">Month</button>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <div class="grid grid-cols-4 gap-4">
            <div class="bg-accent-50 p-4 rounded-lg border border-accent-200">
                <h3 class="text-sm font-medium text-accent-800">Total Records</h3>
                <p class="text-2xl font-bold text-accent-900">@TotalCount.ToString("N0")</p>
            </div>
            <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                <h3 class="text-sm font-medium text-green-800">Keys / Series</h3>
                <p class="text-2xl font-bold text-green-900">@AllKeys.Count</p>
            </div>
            <div class="bg-orange-50 p-4 rounded-lg border border-orange-200">
                <h3 class="text-sm font-medium text-orange-800">Peak @GetPeriodLabel()</h3>
                <p class="text-2xl font-bold text-orange-900">@GlobalMax</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                <h3 class="text-sm font-medium text-gray-800">@GetPeriodLabel() Count</h3>
                <p class="text-2xl font-bold text-gray-900">@PeriodCount</p>
            </div>
        </div>
    </div>

    <!-- Legend -->
    @if (AllKeys.Any())
    {
        <div class="px-6 py-3 border-b border-gray-200 flex flex-wrap gap-3">
            @for (int k = 0; k < AllKeys.Count; k++)
            {
                var key = AllKeys[k];
                var colour = GetColour(k);
                var total = GetKeyTotal(key);
                var isHovered = HoveredKey == key;
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg transition-all duration-150 cursor-default select-none @(isHovered ? "bg-gray-100 shadow-sm" : "hover:bg-gray-50")"
                     @onmouseenter="@(() => { HoveredKey = key; StateHasChanged(); })"
                     @onmouseleave="@(() => { HoveredKey = null; StateHasChanged(); })">
                    <span class="inline-block w-6 h-0.5 rounded-full transition-all duration-150" style="background-color: @colour; height: @(isHovered ? "3px" : "2px");"></span>
                    <span class="text-xs font-medium transition-colors duration-150" style="color: @(isHovered ? colour : "#4b5563");">
                        @(string.IsNullOrWhiteSpace(key) ? "(empty)" : key)
                    </span>
                    <span class="text-xs font-semibold px-1.5 py-0.5 rounded" style="color: @colour; border: 1px solid @colour; opacity: 0.85;">
                        @total.ToString("N0")
                    </span>
                </div>
            }
        </div>
    }

    <!-- Chart -->
    <div class="p-6">
        @if (ChartData.Any())
        {
            <div class="w-full" style="height: 400px;">
                <svg width="100%" height="100%" viewBox="0 0 100 25" preserveAspectRatio="none"
                     class="border border-gray-200 rounded-lg bg-white" role="img" aria-label="@Title Multi-line chart">

                    <!-- Horizontal grid lines -->
                    @for (int i = 0; i <= 10; i++)
                    {
                        var y = 3 + (i * 1.9);
                        <line x1="8" y1="@y" x2="95" y2="@y" stroke="#f0f0f0" stroke-dasharray="0.2,0.2" />
                    }

                    <!-- Vertical grid lines -->
                    @for (int i = 0; i < PeriodLabels.Count; i++)
                    {
                        var x = 8 + (i * (87.0 / Math.Max(PeriodLabels.Count - 1, 1)));
                        <line x1="@x" y1="3" x2="@x" y2="22" stroke="#f0f0f0" stroke-dasharray="0.2,0.2" />
                    }

                    <!-- Y-axis labels -->
                    @for (int i = 0; i <= 10; i++)
                    {
                        var y = 22.1 - (i * 1.9);
                        var value = (int)(GlobalMax * i / 10.0);
                        <svg:text x="6.5" y="@y" font-size="0.8" fill="#6b7280" text-anchor="end">@value</svg:text>
                    }

                    <!-- X-axis labels -->
                    @for (int i = 0; i < PeriodLabels.Count; i++)
                    {
                        var x = 8 + (i * (87.0 / Math.Max(PeriodLabels.Count - 1, 1)));
                        @if (PeriodLabels.Count > 6)
                        {
                            <svg:text x="@x" y="23.5" font-size="0.6" fill="#6b7280" text-anchor="end" transform="rotate(-45 @x 23.5)">@PeriodLabels[i]</svg:text>
                        }
                        else
                        {
                            <svg:text x="@x" y="23.5" font-size="0.6" fill="#6b7280" text-anchor="middle">@PeriodLabels[i]</svg:text>
                        }
                    }

                    <!-- Y-axis title -->
                    <text x="1" y="12.5" font-size="0.8" fill="#6b7280" text-anchor="middle" transform="rotate(-90 1 12.5)">Count</text>

                    <!-- One line per key -->
                    @for (int k = 0; k < AllKeys.Count; k++)
                    {
                        var key = AllKeys[k];
                        var colour = GetColour(k);
                        var path = GenerateLinePath(key);
                        <path d="@path" stroke="@colour"
                              stroke-width="@GetLineWidth(key)"
                              opacity="@GetLineOpacity(key)"
                              fill="none"
                              style="transition: opacity 0.15s ease, stroke-width 0.15s ease;" />
                    }

                    <!-- Data point circles -->
                    @for (int k = 0; k < AllKeys.Count; k++)
                    {
                        var key = AllKeys[k];
                        var colour = GetColour(k);
                        @for (int i = 0; i < PeriodLabels.Count; i++)
                        {
                            var count = GetCount(key, PeriodLabels[i]);
                            var point = GetPointCoordinates(i, count);
                            var label = PeriodLabels[i];
                            <circle cx="@point.X" cy="@point.Y"
                                    r="@(HoveredKey == key ? "0.45" : "0.3")"
                                    fill="@colour" stroke="white" stroke-width="0.1"
                                    opacity="@GetLineOpacity(key)"
                                    class="cursor-pointer"
                                    style="transition: opacity 0.15s ease, Respor 0.15s ease;"
                                    @onmouseover="@(() => ShowTooltip(label, key, count, point.X, point.Y))"
                                    @onmouseout="@HideTooltip">
                                <title>@label — @key: @count</title>
                            </circle>
                        }
                    }

                    <!-- Axes -->
                    <line x1="8" y1="3" x2="8" y2="22" stroke="#6b7280" stroke-width="0.05" />
                    <line x1="8" y1="22" x2="95" y2="22" stroke="#6b7280" stroke-width="0.05" />

                    <!-- Tooltip -->
                    @if (TooltipVisible)
                    {
                        <rect x="@TooltipX" y="@TooltipY" width="12" height="2.5" fill="#fff" stroke="#374151" stroke-width="0.1" rx="0.3" />
                        <svg:text x="@(TooltipX + 0.5)" y="@(TooltipY + 1.5)" font-size="0.7" fill="#111827">@TooltipText</svg:text>
                    }

                </svg>
            </div>
        }
        else
        {
            <div class="flex items-center justify-center h-96 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
                <div class="text-center">
                    <svg class="mx-auto h-16 w-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
                    </svg>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No Data Available</h3>
                    <p class="text-sm text-gray-500">Provide a collection of MultiLineGraphData to display the chart.</p>
                </div>
            </div>
        }
    </div>

    <!-- Recent periods summary per key -->
    @if (ChartData.Any())
    {
        <div class="px-6 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent @GetPeriodLabel()s</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left py-2 pr-4 text-xs font-medium text-gray-500">Key</th>
                            @foreach (var label in PeriodLabels.TakeLast(6))
                            {
                                <th class="text-center py-2 px-3 text-xs font-medium text-gray-500">@label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int k = 0; k < AllKeys.Count; k++)
                        {
                            var key = AllKeys[k];
                            var colour = GetColour(k);
                            <tr class="border-b border-gray-100">
                                <td class="py-2 pr-4">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-block w-3 h-3 rounded-full flex-shrink-0" style="background-color: @colour;"></span>
                                        <span class="text-xs font-medium text-gray-700">@(string.IsNullOrWhiteSpace(key) ? "(empty)" : key)</span>
                                    </div>
                                </td>
                                @foreach (var label in PeriodLabels.TakeLast(6))
                                {
                                    <td class="text-center py-2 px-3 text-xs font-semibold text-gray-900">@GetCount(key, label)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public List<MultiLineGraphData> Data { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Multi-Series Trends";
    [Parameter] public TimePeriod DefaultTimePeriod { get; set; } = TimePeriod.Month;

    public class MultiLineGraphData
    {
        public MultiLineGraphData(DateTime date, string key)
        {
            Date = date;
            Key = key;
        }

        public DateTime Date { get; set; }
        public string Key { get; set; } = string.Empty;
    }

    public enum TimePeriod { Day, Week, Month }

    // Colour palette — 12 distinct colours
    private static readonly string[] Palette = new[]
    {
        "#2563eb", "#16a34a", "#dc2626", "#d97706", "#7c3aed",
        "#0891b2", "#db2777", "#65a30d", "#ea580c", "#0369a1",
        "#9333ea", "#b45309"
    };

    private TimePeriod _currentTimePeriod;

    // Computed chart state
    private List<string> AllKeys { get; set; } = new();
    private List<string> PeriodLabels { get; set; } = new();

    // ChartData[periodLabel][key] = count
    private Dictionary<string, Dictionary<string, int>> ChartData { get; set; } = new();

    private int TotalCount => Data?.Count ?? 0;
    private int GlobalMax => ChartData.Any() ? ChartData.Values.SelectMany(d => d.Values).DefaultIfEmpty(0).Max() : 0;
    private int PeriodCount => PeriodLabels.Count;

    // Tooltip state
    private bool TooltipVisible { get; set; }
    private double TooltipX { get; set; }
    private double TooltipY { get; set; }
    private string TooltipText { get; set; } = "";

    // Legend hover state
    private string? HoveredKey { get; set; } = null;

    private int GetKeyTotal(string key) => Data?.Count(d => (d.Key ?? string.Empty) == key) ?? 0;

    private string GetLineOpacity(string key) =>
        HoveredKey == null || HoveredKey == key ? "1" : "0.12";

    private string GetLineWidth(string key) =>
        HoveredKey == key ? "0.4" : "0.2";

    protected override void OnInitialized()
    {
        _currentTimePeriod = DefaultTimePeriod;
    }

    protected override void OnParametersSet()
    {
        ProcessData();
    }

    private void SetTimePeriod(TimePeriod period)
    {
        _currentTimePeriod = period;
        ProcessData();
    }

    private void ProcessData()
    {
        if (Data == null || !Data.Any())
        {
            AllKeys = new();
            PeriodLabels = new();
            ChartData = new();
            return;
        }

        AllKeys = Data.Select(d => d.Key ?? string.Empty).Distinct().OrderBy(k => k).ToList();

        var grouped = _currentTimePeriod switch
        {
            TimePeriod.Day => Data.GroupBy(d => (Label: d.Date.ToString("MMM dd"), SortKey: d.Date.Date)),
            TimePeriod.Week => Data.GroupBy(d => (Label: $"Week {GetWeekOfYear(GetWeekStart(d.Date))}", SortKey: GetWeekStart(d.Date))),
            TimePeriod.Month => Data.GroupBy(d => (Label: new DateTime(d.Date.Year, d.Date.Month, 1).ToString("MMM yyyy"), SortKey: new DateTime(d.Date.Year, d.Date.Month, 1))),
            _ => Data.GroupBy(d => (Label: new DateTime(d.Date.Year, d.Date.Month, 1).ToString("MMM yyyy"), SortKey: new DateTime(d.Date.Year, d.Date.Month, 1)))
        };

        var ordered = grouped.OrderBy(g => g.Key.SortKey).ToList();

        // Limit to 100 periods
        if (ordered.Count > 100)
            ordered = ordered.Skip(ordered.Count - 100).ToList();

        PeriodLabels = ordered.Select(g => g.Key.Label).ToList();

        ChartData = ordered.ToDictionary(
            g => g.Key.Label,
            g => g.GroupBy(d => d.Key ?? string.Empty)
                  .ToDictionary(kg => kg.Key, kg => kg.Count())
        );
    }

    private int GetCount(string key, string periodLabel)
    {
        if (ChartData.TryGetValue(periodLabel, out var periodDict) &&
            periodDict.TryGetValue(key, out var count))
            return count;
        return 0;
    }

    private string GenerateLinePath(string key)
    {
        if (!PeriodLabels.Any()) return "";

        var commands = new List<string>();
        for (int i = 0; i < PeriodLabels.Count; i++)
        {
            var count = GetCount(key, PeriodLabels[i]);
            var point = GetPointCoordinates(i, count);
            commands.Add(i == 0 ? $"M {point.X} {point.Y}" : $"L {point.X} {point.Y}");
        }
        return string.Join(" ", commands);
    }

    private (double X, double Y) GetPointCoordinates(int index, int count)
    {
        var x = 8 + (index * (87.0 / Math.Max(PeriodLabels.Count - 1, 1)));
        var normalised = GlobalMax > 0 ? (double)count / GlobalMax : 0;
        var y = 22 - (normalised * 19);
        return (x, y);
    }

    private string GetColour(int index) => Palette[index % Palette.Length];

    private void ShowTooltip(string label, string key, int count, double x, double y)
    {
        TooltipVisible = true;
        TooltipX = Math.Min(x + 0.5, 83);
        TooltipY = Math.Max(y - 3, 3.5);
        TooltipText = $"{label} — {key}: {count}";
        StateHasChanged();
    }

    private void HideTooltip()
    {
        TooltipVisible = false;
        StateHasChanged();
    }

    private string GetToggleButtonClass(TimePeriod period)
    {
        var baseClass = "px-4 py-2 text-sm font-medium transition-colors";
        return period == _currentTimePeriod
            ? $"{baseClass} bg-accent-600 text-white"
            : $"{baseClass} bg-white text-gray-700 hover:bg-gray-50";
    }

    private string GetPeriodLabel() => _currentTimePeriod switch
    {
        TimePeriod.Day => "Day",
        TimePeriod.Week => "Week",
        TimePeriod.Month => "Month",
        _ => "Period"
    };

    private DateTime GetWeekStart(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-1 * diff).Date;
    }

    private int GetWeekOfYear(DateTime date)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        return culture.Calendar.GetWeekOfYear(date, culture.DateTimeFormat.CalendarWeekRule, culture.DateTimeFormat.FirstDayOfWeek);
    }
}
